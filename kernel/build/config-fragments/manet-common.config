# Out-of-tree module compatibility - CRITICAL
CONFIG_TRIM_UNUSED_KSYMS=n
CONFIG_DEBUG_INFO_BTF=n

# BATMAN-ADV
CONFIG_BATMAN_ADV=m
CONFIG_BATMAN_ADV_DAT=y
CONFIG_BATMAN_ADV_NC=y
CONFIG_BATMAN_ADV_MCAST=y
CONFIG_BATMAN_ADV_BLA=y

# 802.11 stack (morse depends on these)
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# Mesh point iftype - without this wpa_supplicant reports "Driver does not
# support mesh mode" (RPi defconfigs set it; mainline arm64 does not)
CONFIG_MAC80211_MESH=y
CONFIG_CRC7=m

# MT7916 WiFi (all platforms use M.2 MT7916 card via mt7915e driver)
CONFIG_MT7915E=m

# ebtables (needed for mesh bridge filtering)
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_EBTABLES=m
CONFIG_EBTABLE_FILTER=m

# nftables (gateway NAT/firewall - /etc/nftables.conf + manet-uplink-dispatch)
# RPi defconfigs carry these; mainline arm64 defconfig does not.
CONFIG_NETFILTER_NETLINK=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_INET=m

# SPI for HaLow card
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=m

# CPU frequency governors
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Thermal core
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# Disable regDB
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=n

# Local version
CONFIG_LOCALVERSION="-manet"
CONFIG_LOCALVERSION_AUTO=n
