# RK3568 thermal
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_ROCKCHIP_PM_DOMAINS=y

# Consistent interface naming off
CONFIG_NET_NS=y

# MT7916 report capture through tracefs, without function instrumentation.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# These default on with tracing but are not needed for static MT7916 events.
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_EPROBE_EVENTS is not set
# CONFIG_IWLWIFI_DEVICE_TRACING is not set
