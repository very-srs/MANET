From: MANET maintainers
Subject: [PATCH] cfg80211: opt in a same-radio DFS follower AP

Require paired userspace intent, the load-time mt7915e gate and a
current ordinary BSS station for a 20 MHz follower. Track that
permission separately from DFS availability and stop the AP on
association loss or upstream CSA. Keep ordinary AP and the existing
P2P GO admission checks unchanged.

diff --git a/net/wireless/ap.c b/net/wireless/ap.c
--- a/net/wireless/ap.c
+++ b/net/wireless/ap.c
@@ -32,6 +32,7 @@ static int ___cfg80211_stop_ap(struct cfg80211_registered_device *rdev,
 
 	err = rdev_stop_ap(rdev, dev, link_id);
 	if (!err) {
+		cfg80211_dfs_follow_del(wdev, link_id);
 		wdev->conn_owner_nlportid = 0;
 		wdev->links[link_id].ap.beacon_interval = 0;
 		memset(&wdev->links[link_id].ap.chandef, 0,
diff --git a/net/wireless/chan.c b/net/wireless/chan.c
--- a/net/wireless/chan.c
+++ b/net/wireless/chan.c
@@ -10,11 +10,29 @@
  */
 
 #include <linux/export.h>
+#include <linux/moduleparam.h>
 #include <linux/bitfield.h>
 #include <net/cfg80211.h>
 #include "core.h"
 #include "rdev-ops.h"
 
+static bool dfs_follow_ap_v1;
+module_param(dfs_follow_ap_v1, bool, 0444);
+MODULE_PARM_DESC(dfs_follow_ap_v1,
+		 "Enable paired MANET AP/STA DFS follower on mt7915e (default off)");
+
+struct cfg80211_dfs_follow_ap {
+	struct list_head list;
+	struct wireless_dev *wdev;
+	unsigned int link;
+};
+
+bool cfg80211_dfs_follow_enabled(struct wiphy *wiphy)
+{
+	return dfs_follow_ap_v1 && wiphy_dev(wiphy) &&
+	       !strcmp(dev_driver_string(wiphy_dev(wiphy)), "mt7915e");
+}
+
 static bool cfg80211_valid_60g_freq(u32 freq)
 {
 	return freq >= 58320 && freq <= 70200;
@@ -693,14 +711,19 @@ static bool cfg80211_dfs_permissive_chan(struct wiphy *wiphy,
 
 	lockdep_assert_held(&rdev->wiphy.mtx);
 
-	if (!wiphy_ext_feature_isset(&rdev->wiphy,
-				     NL80211_EXT_FEATURE_DFS_CONCURRENT) ||
-	    !(chan->flags & IEEE80211_CHAN_DFS_CONCURRENT))
-		return false;
-
-	/* only valid for P2P GO */
-	if (iftype != NL80211_IFTYPE_P2P_GO)
+	if (iftype == NL80211_IFTYPE_AP) {
+		if (!cfg80211_dfs_follow_enabled(wiphy) ||
+		    rdev->dfs_follow_start < 0 || rdev->dfs_follow_csa ||
+		    (!rdev->dfs_follow_start && list_empty(&rdev->dfs_follow_aps)) ||
+		    chan->dfs_state == NL80211_DFS_UNAVAILABLE ||
+		    chan->flags & IEEE80211_CHAN_DISABLED)
+			return false;
+	} else if (iftype != NL80211_IFTYPE_P2P_GO ||
+		   !wiphy_ext_feature_isset(wiphy,
+					    NL80211_EXT_FEATURE_DFS_CONCURRENT) ||
+		   !(chan->flags & IEEE80211_CHAN_DFS_CONCURRENT)) {
 		return false;
+	}
 
 	/*
 	 * Allow only if there's a concurrent BSS
@@ -715,6 +738,80 @@ static bool cfg80211_dfs_permissive_chan(struct wiphy *wiphy,
 	return false;
 }
 
+bool cfg80211_dfs_follow_chandef(struct wireless_dev *wdev,
+				 const struct cfg80211_chan_def *chandef)
+{
+	if (wdev->iftype != NL80211_IFTYPE_AP || wdev->valid_links ||
+	    !chandef->chan ||
+	    (chandef->width != NL80211_CHAN_WIDTH_20 &&
+	     chandef->width != NL80211_CHAN_WIDTH_20_NOHT) ||
+	    !(chandef->chan->flags & IEEE80211_CHAN_RADAR))
+		return false;
+	return cfg80211_dfs_permissive_chan(wdev->wiphy, wdev->iftype,
+					   chandef->chan);
+}
+
+int cfg80211_dfs_follow_add(struct wireless_dev *wdev, unsigned int link)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wdev->wiphy);
+	struct cfg80211_dfs_follow_ap *ap;
+	struct wireless_dev *other;
+
+	lockdep_assert_wiphy(wdev->wiphy);
+	/* This protocol supports one AP beside the BSS STA, not MBSSID or
+	 * another beaconing role sharing detector state on this PHY.
+	 */
+	if (!list_empty(&rdev->dfs_follow_aps))
+		return -EBUSY;
+	list_for_each_entry(other, &rdev->wiphy.wdev_list, list)
+		if (other != wdev && cfg80211_beaconing_iface_active(other))
+			return -EBUSY;
+	ap = kzalloc(sizeof(*ap), GFP_KERNEL);
+	if (!ap)
+		return -ENOMEM;
+	ap->wdev = wdev;
+	ap->link = link;
+	list_add_tail(&ap->list, &rdev->dfs_follow_aps);
+	return 0;
+}
+
+void cfg80211_dfs_follow_del(struct wireless_dev *wdev, int link)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wdev->wiphy);
+	struct cfg80211_dfs_follow_ap *ap, *tmp;
+
+	lockdep_assert_wiphy(wdev->wiphy);
+	list_for_each_entry_safe(ap, tmp, &rdev->dfs_follow_aps, list) {
+		if (ap->wdev != wdev || (link >= 0 && ap->link != link))
+			continue;
+		list_del(&ap->list);
+		kfree(ap);
+	}
+}
+
+void cfg80211_dfs_follow_check(struct wiphy *wiphy, bool force)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	struct cfg80211_dfs_follow_ap *ap, *tmp;
+
+	lockdep_assert_wiphy(wiphy);
+	list_for_each_entry_safe(ap, tmp, &rdev->dfs_follow_aps, list) {
+		struct wireless_dev *wdev = ap->wdev;
+		unsigned int link = ap->link;
+
+		if (!force && cfg80211_dfs_follow_chandef(wdev,
+							  &wdev->links[link].ap.chandef))
+			continue;
+		/* No regulatory grace and no reliance on DFS_AVAILABLE. mt7915
+		 * stop_ap synchronously disables beaconing and removes stations.
+		 * Keep the record if a driver reports failure so a later check
+		 * can retry; successful stop removes it in ap.c.
+		 */
+		if (cfg80211_stop_ap(rdev, wdev->netdev, link, true))
+			wiphy_warn(wiphy, "MANET DFS follower stop failed\n");
+	}
+}
+
 static int cfg80211_get_chans_dfs_required(struct wiphy *wiphy,
 					   const struct cfg80211_chan_def *chandef,
 					   enum nl80211_iftype iftype)
diff --git a/net/wireless/core.c b/net/wireless/core.c
--- a/net/wireless/core.c
+++ b/net/wireless/core.c
@@ -598,6 +598,7 @@ use_default_name:
 	}
 
 	mutex_init(&rdev->wiphy.mtx);
+	INIT_LIST_HEAD(&rdev->dfs_follow_aps);
 	INIT_LIST_HEAD(&rdev->wiphy.wdev_list);
 	INIT_LIST_HEAD(&rdev->beacon_registrations);
 	spin_lock_init(&rdev->beacon_registrations_lock);
@@ -1382,7 +1383,12 @@ static void _cfg80211_unregister_wdev(struct wireless_dev *wdev,
 			unregister_netdevice(wdev->netdev);
 	}
 
+	cfg80211_dfs_follow_del(wdev, -1);
 	list_del_rcu(&wdev->list);
+	if (wdev->iftype == NL80211_IFTYPE_STATION) {
+		rdev->dfs_follow_csa = false;
+		cfg80211_dfs_follow_check(wdev->wiphy, false);
+	}
 	synchronize_net();
 	rdev->devlist_generation++;
 	wiphy_work_cancel(wdev->wiphy, &wdev->disconnect_wk);
