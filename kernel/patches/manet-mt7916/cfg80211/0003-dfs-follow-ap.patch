+void cfg80211_dfs_follow_check(struct wiphy *wiphy, bool force);
+
 struct cfg80211_scan_request_int {
 	struct cfg80211_scan_info info;
 	bool notified;
@@ -99,6 +108,11 @@ struct cfg80211_registered_device {
 	struct work_struct conn_work;
 	struct work_struct event_work;
 
+	/* MANET DFS follower v1: private state, protected by wiphy mutex. */
+	struct list_head dfs_follow_aps;
+	int dfs_follow_start; /* -1 ordinary START_AP, 0 idle, 1 follower */
+	bool dfs_follow_csa;
+
 	struct delayed_work dfs_update_channels_wk;
 
 	struct wireless_dev *background_radar_wdev;
diff --git a/net/wireless/nl80211.c b/net/wireless/nl80211.c
