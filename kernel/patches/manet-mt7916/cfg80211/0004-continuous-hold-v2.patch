diff --git a/net/wireless/hold-api.h b/net/wireless/hold-api.h
new file mode 100644
--- /dev/null
+++ b/net/wireless/hold-api.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MANET_HOLD_API_V2_H
+#define __MANET_HOLD_API_V2_H
+
+/* Private paired-module API. No existing public structure is extended.
+ * Keep the copies in cfg80211 and mt7915 identical.
+ */
+#define MANET_HOLD_MAX_AGE_US 1500000ULL
+#define MANET_HOLD_POLL_MS 250
+struct manet_hold_token {
+	u64 epoch[2];
+	u64 generation;
+};
+
+struct manet_hold_sample {
+	u64 at_us, elapsed_us, sequence;
+	u64 tx_first_us, tx_last_us, tx_read_max_us;
+	u32 delta[12];
+	u32 sample_count, energy_permille, energy_upper_permille;
+	bool valid;
+};
+
+bool cfg80211_hold_token_v2(struct wiphy *wiphy, struct manet_hold_token *token);
+bool cfg80211_hold_sample_v2(struct wiphy *wiphy,
+			   const struct manet_hold_token *token,
+			   const struct manet_hold_sample *sample);
+#endif
diff --git a/net/wireless/hold-debugfs.inc b/net/wireless/hold-debugfs.inc
new file mode 100644
--- /dev/null
+++ b/net/wireless/hold-debugfs.inc
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+static int background_hold_show(struct seq_file *seq, void *unused)
+{
+	struct wiphy *wiphy = seq->private;
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	struct manet_hold_sample sample;
+	struct manet_hold_token token, radar;
+	unsigned long flags;
+	u64 now, age, radar_sequence, radar_at;
+	bool enabled, owner, fault, fresh, live, revoked;
+	const char *reason, *cause;
+	int freq, radar_freq, i;
+
+	if (!mutex_trylock(&wiphy->mtx))
+		return -EBUSY;
+	spin_lock_irqsave(&rdev->background_hold_lock, flags);
+	now = ktime_to_us(ktime_get_boottime());
+	sample = rdev->background_hold_sample;
+	token = rdev->background_hold_token;
+	radar = rdev->background_hold_radar_token;
+	enabled = rdev->background_hold_enabled;
+	owner = !!rdev->background_radar_wdev;
+	fault = rdev->background_hold_fault;
+	revoked = rdev->background_hold_revoked;
+	age = sample.at_us && now >= sample.at_us ? now - sample.at_us : U64_MAX;
+	fresh = enabled && owner && !fault && !revoked && age < MANET_HOLD_MAX_AGE_US;
+	live = fresh && rdev->background_hold_active &&
+		rdev->background_radar_chandef.chan &&
+		rdev->background_radar_chandef.chan->dfs_state == NL80211_DFS_AVAILABLE;
+	freq = rdev->background_radar_chandef.chan ?
+		rdev->background_radar_chandef.chan->center_freq : 0;
+	reason = rdev->background_hold_reason ?: "none";
+	cause = rdev->background_hold_radar_cause ?: "none";
+	radar_sequence = rdev->background_hold_radar_sequence;
+	radar_at = rdev->background_hold_radar_at_us;
+	radar_freq = rdev->background_hold_radar_freq;
+	spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+	mutex_unlock(&wiphy->mtx);
+
+#define BOOL(v) ((v) ? "true" : "false")
+	seq_printf(seq, "{\"schema\":2,\"experimental\":true,\"enabled\":%s,"
+		"\"generation\":%llu,\"epoch\":\"%016llx%016llx\","
+		"\"owner\":%s,\"fault\":%s,\"live\":%s,\"receiver_live\":%s,"
+		"\"revoked\":%s,\"reason\":\"%s\",\"freq_mhz\":%d,\"width_mhz\":20,"
+		"\"center_mhz\":%d,\"observed_boottime_us\":%llu,"
+		"\"heartbeat_boottime_us\":%llu,\"heartbeat_max_age_us\":%llu,",
+		BOOL(enabled), token.generation, token.epoch[0], token.epoch[1],
+		BOOL(owner), BOOL(fault), BOOL(live), BOOL(fresh), BOOL(revoked), reason,
+		freq, freq, now, sample.at_us, MANET_HOLD_MAX_AGE_US);
+	seq_printf(seq, "\"radar_sequence\":%llu,\"radar_cause\":\"%s\","
+		"\"radar_epoch\":\"%016llx%016llx\",\"radar_generation\":%llu,"
+		"\"radar_freq_mhz\":%d,\"radar_boottime_us\":%llu,",
+		radar_sequence, cause, radar.epoch[0], radar.epoch[1], radar.generation,
+		radar_freq, radar_at);
+	seq_printf(seq, "\"occupancy\":{\"schema\":1,\"valid\":%s,"
+		"\"epoch\":\"%016llx%016llx\",\"generation\":%llu,\"freq_mhz\":%d,"
+		"\"sequence\":%llu,\"threshold_bucket\":2,\"sample_count\":%u,"
+		"\"observed_boottime_us\":%llu,\"elapsed_us\":%llu,"
+		"\"energy_permille\":%u,\"energy_upper_permille\":%u,"
+		"\"tx_first_us\":%llu,\"tx_last_us\":%llu,\"tx_read_max_us\":%llu,\"delta\":[",
+		BOOL(fresh && sample.valid), token.epoch[0], token.epoch[1], token.generation,
+		freq, sample.sequence, sample.sample_count, sample.at_us, sample.elapsed_us,
+		sample.energy_permille, sample.energy_upper_permille,
+		sample.tx_first_us, sample.tx_last_us, sample.tx_read_max_us);
+	for (i = 0; i < ARRAY_SIZE(sample.delta); i++)
+		seq_printf(seq, "%s%u", i ? "," : "", sample.delta[i]);
+	seq_puts(seq, "]}}\n");
+#undef BOOL
+	return 0;
+}
+
+static int background_hold_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, background_hold_show, inode->i_private);
+}
+
+static ssize_t background_hold_write(struct file *file, const char __user *userbuf,
+				     size_t count, loff_t *ppos)
+{
+	struct seq_file *seq = file->private_data;
+	struct wiphy *wiphy = seq->private;
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	char buf[8];
+	unsigned long flags;
+	int ret = 0;
+
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, userbuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+	if (!mutex_trylock(&wiphy->mtx))
+		return -EBUSY;
+	if (sysfs_streq(buf, "enable")) {
+		if (rdev->background_radar_wdev ||
+		    work_busy(&rdev->background_cac_abort_wk) ||
+		    work_busy(&rdev->background_cac_done_wk.work))
+			ret = -EBUSY;
+		else {
+			spin_lock_irqsave(&rdev->background_hold_lock, flags);
+			rdev->background_hold_enabled = true;
+			spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+		}
+	} else if (sysfs_streq(buf, "stop")) {
+		if (rdev->background_radar_wdev)
+			cfg80211_stop_background_radar_detection(rdev->background_radar_wdev);
+		if (rdev->background_radar_wdev)
+			ret = -EIO;
+		else {
+			spin_lock_irqsave(&rdev->background_hold_lock, flags);
+			rdev->background_hold_enabled = false;
+			spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+		}
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&wiphy->mtx);
+	return ret ? ret : count;
+}
+
+static const struct file_operations background_hold_ops = {
+	.owner = THIS_MODULE,
+	.open = background_hold_open,
+	.read = seq_read,
+	.write = background_hold_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
diff --git a/net/wireless/hold-monitor.inc b/net/wireless/hold-monitor.inc
new file mode 100644
--- /dev/null
+++ b/net/wireless/hold-monitor.inc
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/random.h>
+
+/* All fields are protected by background_hold_lock. No driver call or
+ * sleeping operation is made while holding it. Driver publication takes
+ * this lock under mt76.mutex; this layer never takes that mutex.
+ */
+static u64 background_hold_now(void)
+{
+	return ktime_to_us(ktime_get_boottime());
+}
+
+static bool background_hold_fresh(struct cfg80211_registered_device *rdev,
+				  u64 now)
+{
+	u64 at = rdev->background_hold_sample.at_us;
+
+	return at && now >= at && now - at < MANET_HOLD_MAX_AGE_US;
+}
+
+static bool background_hold_expired(struct cfg80211_registered_device *rdev,
+				    u64 now)
+{
+	u64 at = rdev->background_hold_sample.at_us;
+
+	if (!at)
+		at = rdev->background_hold_started_us;
+	return now < at || now - at >= MANET_HOLD_MAX_AGE_US;
+}
+
+bool cfg80211_hold_token_v2(struct wiphy *wiphy, struct manet_hold_token *token)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&rdev->background_hold_lock, flags);
+	valid = rdev->background_hold_enabled && rdev->background_radar_wdev &&
+		!rdev->background_hold_revoked && !rdev->background_hold_fault;
+	if (valid)
+		*token = rdev->background_hold_token;
+	spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+	return valid;
+}
+EXPORT_SYMBOL_GPL(cfg80211_hold_token_v2);
+
+bool cfg80211_hold_sample_v2(struct wiphy *wiphy,
+			   const struct manet_hold_token *token,
+			   const struct manet_hold_sample *sample)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	unsigned long flags;
+	u64 now = background_hold_now();
+	bool valid, abort = false;
+
+	spin_lock_irqsave(&rdev->background_hold_lock, flags);
+	valid = rdev->background_hold_enabled && rdev->background_radar_wdev &&
+		!rdev->background_hold_revoked && !rdev->background_hold_fault &&
+		!memcmp(token, &rdev->background_hold_token, sizeof(*token));
+	if (valid && (background_hold_expired(rdev, now) ||
+		      !sample->at_us || sample->at_us > now ||
+		      now - sample->at_us >= MANET_HOLD_MAX_AGE_US ||
+		      sample->at_us <= rdev->background_hold_sample.at_us ||
+		      sample->sequence <= rdev->background_hold_sample.sequence)) {
+		cfg80211_background_hold_revoke(rdev);
+		rdev->background_hold_reason = "heartbeat-expired";
+		valid = false;
+		abort = true;
+	}
+	if (valid)
+		rdev->background_hold_sample = *sample;
+	spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+	if (abort)
+		queue_work(cfg80211_wq, &rdev->background_cac_abort_wk);
+	return valid;
+}
+EXPORT_SYMBOL_GPL(cfg80211_hold_sample_v2);
+
+/* Independent of driver MCU waits and of the cfg80211 serial workqueue.
+ * Reads also enforce the deadline, even if this worker is delayed.
+ */
+void cfg80211_background_hold_watch(struct work_struct *work)
+{
+	struct cfg80211_registered_device *rdev = container_of(work,
+		struct cfg80211_registered_device, background_hold_watch.work);
+	unsigned long flags;
+	bool abort = false;
+
+	spin_lock_irqsave(&rdev->background_hold_lock, flags);
+	if (rdev->background_hold_enabled && rdev->background_radar_wdev &&
+	    !rdev->background_hold_revoked) {
+		if (background_hold_expired(rdev, background_hold_now())) {
+			cfg80211_background_hold_revoke(rdev);
+			rdev->background_hold_reason = "heartbeat-expired";
+			abort = true;
+		} else {
+			mod_delayed_work(system_wq, &rdev->background_hold_watch,
+					 msecs_to_jiffies(MANET_HOLD_POLL_MS));
+		}
+	}
+	spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+	if (abort)
+		queue_work(cfg80211_wq, &rdev->background_cac_abort_wk);
+}
