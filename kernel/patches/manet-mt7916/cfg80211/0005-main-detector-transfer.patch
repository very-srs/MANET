diff --git a/net/wireless/hold-monitor.inc b/net/wireless/hold-monitor.inc
--- a/net/wireless/hold-monitor.inc
+++ b/net/wireless/hold-monitor.inc
@@ -102,3 +102,53 @@
 	if (abort)
 		queue_work(cfg80211_wq, &rdev->background_cac_abort_wk);
 }
+
+/* The driver holds mt76.mutex. RDD2 is still running and the main RDD has
+ * acknowledged start. Freeze its identity before asynchronous RDD2 teardown.
+ * No availability gap: revoke preserves AVAILABLE while this main owns it.
+ */
+bool cfg80211_hold_transfer_v3(struct wiphy *wiphy,
+                             const struct cfg80211_chan_def *chandef,
+                             const struct manet_hold_token *token)
+{
+ struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+ unsigned long flags;
+ bool valid;
+
+ spin_lock_irqsave(&rdev->background_hold_lock, flags);
+ valid = rdev->background_hold_enabled && rdev->background_radar_wdev &&
+         rdev->background_hold_active && !rdev->background_hold_revoked &&
+         !rdev->background_hold_fault && background_hold_fresh(rdev, background_hold_now()) &&
+         !memcmp(token, &rdev->background_hold_token, sizeof(*token)) &&
+         cfg80211_chandef_identical(chandef, &rdev->background_radar_chandef) &&
+         chandef->chan->dfs_state == NL80211_DFS_AVAILABLE;
+ if (valid) {
+  rdev->hold_main_token = *token;
+  rdev->hold_main_chandef = *chandef;
+  rdev->hold_main_active = true;
+  cfg80211_background_hold_revoke(rdev);
+  rdev->background_hold_reason = "main-transfer";
+ }
+ spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+ if (valid)
+  queue_work(cfg80211_wq, &rdev->background_cac_abort_wk);
+ return valid;
+}
+EXPORT_SYMBOL_GPL(cfg80211_hold_transfer_v3);
+
+void cfg80211_hold_main_stop_v3(struct wiphy *wiphy)
+{
+ struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+ struct ieee80211_channel *chan;
+ unsigned long flags;
+
+ spin_lock_irqsave(&rdev->background_hold_lock, flags);
+ chan = rdev->hold_main_chandef.chan;
+ if (rdev->hold_main_active && chan && chan->dfs_state == NL80211_DFS_AVAILABLE) {
+  chan->dfs_state = NL80211_DFS_USABLE;
+  chan->dfs_state_entered = jiffies;
+ }
+ rdev->hold_main_active = false;
+ spin_unlock_irqrestore(&rdev->background_hold_lock, flags);
+}
+EXPORT_SYMBOL_GPL(cfg80211_hold_main_stop_v3);
