From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MANET <manet@localhost>
Date: Wed, 7 Oct 2026 12:00:00 -0600
Subject: [PATCH 3/3] mt76: mt7915: control ACK spatial extension for ranging

Expose the four per-band ACK/BA/CTS response spatial-extension indices.
Save their original words on first write and support explicit restoration.
No register is changed until userspace writes this control.

---
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c b/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
--- a/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
@@ -1477,6 +1477,88 @@
 DEFINE_DEBUGFS_ATTRIBUTE(fops_tmr_rate, mt7915_tmr_rate_get,
 			 mt7915_tmr_rate_set, "0x%08llx\n");
 
+/*
+ * ACK/BA/CTS spatial-extension index of the four BSSID response contexts
+ * (TMAC B0..B3BRR1 bits 28:24). Write 0..31 to set all four (the first
+ * write saves the original words), or "restore" to put them back. A boot
+ * or reload resets them to the firmware default.
+ */
+#define MT_TMAC_BRR1_SPE	GENMASK(28, 24)
+
+static const u16 mt7915_tmr_brr1_ofs[4] = { 0x24, 0x54, 0x64, 0x74 };
+
+static ssize_t mt7915_tmr_ack_spe_write(struct file *file,
+					const char __user *ubuf,
+					size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	struct mt7915_dev *dev = phy->dev;
+	u8 band = phy->mt76->band_idx;
+	ssize_t ret = count;
+	char buf[16];
+	u8 val;
+	int i;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	mutex_lock(&dev->mt76.mutex);
+	if (sysfs_streq(buf, "restore")) {
+		if (phy->tmr_brr1_saved)
+			for (i = 0; i < 4; i++)
+				mt76_wr(dev, MT_WF_TMAC(band, mt7915_tmr_brr1_ofs[i]),
+					phy->tmr_brr1[i]);
+		phy->tmr_brr1_saved = false;
+	} else if (!kstrtou8(strim(buf), 0, &val) && val <= 31) {
+		for (i = 0; i < 4; i++) {
+			u32 reg = MT_WF_TMAC(band, mt7915_tmr_brr1_ofs[i]);
+
+			if (!phy->tmr_brr1_saved)
+				phy->tmr_brr1[i] = mt76_rr(dev, reg);
+			mt76_rmw_field(dev, reg, MT_TMAC_BRR1_SPE, val);
+		}
+		phy->tmr_brr1_saved = true;
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&dev->mt76.mutex);
+
+	return ret;
+}
+
+static ssize_t mt7915_tmr_ack_spe_read(struct file *file, char __user *ubuf,
+				       size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	struct mt7915_dev *dev = phy->dev;
+	u8 band = phy->mt76->band_idx;
+	char buf[64];
+	int len, i;
+
+	mutex_lock(&dev->mt76.mutex);
+	len = scnprintf(buf, sizeof(buf), "%s", phy->tmr_brr1_saved ?
+			"set" : "default");
+	for (i = 0; i < 4; i++)
+		len += scnprintf(buf + len, sizeof(buf) - len, " %lu",
+				 FIELD_GET(MT_TMAC_BRR1_SPE,
+					   mt76_rr(dev, MT_WF_TMAC(band,
+						   mt7915_tmr_brr1_ofs[i]))));
+	mutex_unlock(&dev->mt76.mutex);
+	len += scnprintf(buf + len, sizeof(buf) - len, "\n");
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static const struct file_operations mt7915_tmr_ack_spe_fops = {
+	.write = mt7915_tmr_ack_spe_write,
+	.read = mt7915_tmr_ack_spe_read,
+	.open = simple_open,
+	.llseek = default_llseek,
+};
+
 static const struct file_operations mt7915_tmr_peer_fops = {
 	.write = mt7915_tmr_peer_write,
 	.read = mt7915_tmr_peer_read,
@@ -1506,6 +1588,8 @@
 				    &fops_tmr_mark);
 		debugfs_create_file("tmr_rate", 0600, dir, dev,
 				    &fops_tmr_rate);
+		debugfs_create_file("tmr_ack_spe", 0600, dir, phy,
+				    &mt7915_tmr_ack_spe_fops);
 	}
 	debugfs_create_file("muru_debug", 0600, dir, dev, &fops_muru_debug);
 	debugfs_create_file("muru_stats", 0400, dir, phy,
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h b/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h
--- a/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h
@@ -225,6 +225,9 @@
 	struct mt76_mib_stats mib;
 	struct mt76_channel_state state_ts;
 
+	/* ACK/BA/CTS SPE words saved by tmr_ack_spe */
+	u32 tmr_brr1[4];
+	bool tmr_brr1_saved;
 
 #ifdef CONFIG_NL80211_TESTMODE
 	struct {
-- 
