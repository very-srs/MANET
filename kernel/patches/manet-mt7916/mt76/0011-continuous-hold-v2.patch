diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/hold-api.h b/drivers/net/wireless/mediatek/mt76/mt7915/hold-api.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/hold-api.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MANET_HOLD_API_V2_H
+#define __MANET_HOLD_API_V2_H
+
+/* Private paired-module API. No existing public structure is extended.
+ * Keep the copies in cfg80211 and mt7915 identical.
+ */
+#define MANET_HOLD_MAX_AGE_US 1500000ULL
+#define MANET_HOLD_POLL_MS 250
+struct manet_hold_token {
+	u64 epoch[2];
+	u64 generation;
+};
+
+struct manet_hold_sample {
+	u64 at_us, elapsed_us, sequence;
+	u64 tx_first_us, tx_last_us, tx_read_max_us;
+	u32 delta[12];
+	u32 sample_count, energy_permille, energy_upper_permille;
+	bool valid;
+};
+
+bool cfg80211_hold_token_v2(struct wiphy *wiphy, struct manet_hold_token *token);
+bool cfg80211_hold_sample_v2(struct wiphy *wiphy,
+			   const struct manet_hold_token *token,
+			   const struct manet_hold_sample *sample);
+#endif
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/hold-driver.inc b/drivers/net/wireless/mediatek/mt76/mt7915/hold-driver.inc
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/hold-driver.inc
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: ISC */
+/* Read-only tap on the detector owned by cfg80211. No ext9A, RDD command,
+ * histogram reset, register write or receiver acquisition in this worker.
+ */
+/* Bench-only fault injection: suppress sampling, never keep a lease alive. */
+static bool mt7915_hold_pause;
+module_param_named(background_hold_pause, mt7915_hold_pause, bool, 0600);
+MODULE_PARM_DESC(background_hold_pause, "Pause experimental hold sampling to test expiry");
+
+void mt7915_hold_stop(struct mt7915_dev *dev)
+{
+	lockdep_assert_held(&dev->mt76.mutex);
+	dev->hold.active = false;
+	cancel_delayed_work(&dev->hold.work);
+}
+
+static void mt7915_hold_work(struct work_struct *work)
+{
+	struct mt7915_hold_monitor *hold = container_of(work,
+		struct mt7915_hold_monitor, work.work);
+	struct mt7915_dev *dev = container_of(hold, struct mt7915_dev, hold);
+	struct mt7915_bg_scan scan = { .threshold = 2 };
+	struct manet_hold_sample sample = {};
+	struct manet_hold_token token_now;
+	struct mt7915_phy *phy;
+	u64 start, at, tx, read_us;
+	int ret;
+
+	mutex_lock(&dev->mt76.mutex);
+	if (!hold->active)
+		goto out;
+	phy = hold->phy;
+	if (!mt7915_bg_scan_mcu_ready(dev) || dev->rdd2_phy != phy ||
+	    dev->bg_scan.dirty ||
+	    !test_bit(MT76_STATE_RUNNING, &phy->mt76->state) ||
+	    test_bit(MT76_SCANNING, &phy->mt76->state) ||
+	    !cfg80211_hold_token_v2(phy->mt76->hw->wiphy, &token_now) ||
+	    memcmp(&token_now, &hold->token, sizeof(token_now)))
+		goto abort;
+
+	if (READ_ONCE(mt7915_hold_pause))
+		goto reschedule;
+
+	/* The dedicated detector must remain enabled as well as sampling.
+	 * Counter cadence independently catches a frozen or disconnected bank.
+	 */
+	if (!(mt76_rr(dev, 0x831a5c00) & BIT(0)))
+		goto abort;
+	start = ktime_to_us(ktime_get_boottime());
+	ret = mt7915_mcu_get_chan_mib_info(phy, false);
+	if (ret)
+		goto abort;
+	tx = phy->mt76->chan_state->cc_tx;
+	mt7915_bg_read_bins(dev, &scan.last);
+	at = ktime_to_us(ktime_get_boottime());
+	read_us = at - start;
+	if (hold->at_us) {
+		scan.first = hold->previous;
+		scan.elapsed_us = at - hold->at_us;
+		/* A slow query cannot supply a recently running receiver proof. */
+		if (read_us >= MANET_HOLD_MAX_AGE_US ||
+		    scan.elapsed_us >= MANET_HOLD_MAX_AGE_US ||
+		    mt7915_bg_scan_calculate(&scan))
+			goto abort;
+		sample.at_us = at;
+		sample.elapsed_us = scan.elapsed_us;
+		sample.sequence = ++hold->sequence;
+		sample.tx_first_us = hold->tx_us;
+		sample.tx_last_us = tx;
+		sample.tx_read_max_us = max(read_us, hold->read_us);
+		memcpy(sample.delta, scan.delta.bins, sizeof(sample.delta));
+		sample.sample_count = scan.sample_count;
+		sample.energy_permille = scan.busy_permille;
+		sample.energy_upper_permille = scan.busy_raw_permille;
+		/* High local TX or slow MIB alignment invalidates occupancy,
+		 * without declaring a running receiver dead. Keep the raw data.
+		 */
+		sample.valid = tx >= hold->tx_us &&
+			tx - hold->tx_us < scan.elapsed_us * 9 / 10 &&
+			(tx - hold->tx_us) * scan.sample_count * 20 <=
+			scan.elapsed_us * ((u64)scan.delta.bins[10] * 20 + scan.sample_count) &&
+			sample.tx_read_max_us <= min_t(u64, 10000, scan.elapsed_us / 20);
+		if (!cfg80211_hold_sample_v2(phy->mt76->hw->wiphy,
+					    &hold->token, &sample))
+			goto abort;
+	}
+	hold->previous = scan.last;
+	hold->at_us = at;
+	hold->tx_us = tx;
+	hold->read_us = read_us;
+reschedule:
+	mod_delayed_work(system_wq, &hold->work,
+			 msecs_to_jiffies(MANET_HOLD_POLL_MS));
+	goto out;
+abort:
+	mt7915_hold_stop(dev);
+	cfg80211_background_cac_abort(phy->mt76->hw->wiphy);
+out:
+	mutex_unlock(&dev->mt76.mutex);
+}
+
+void mt7915_hold_start(struct mt7915_phy *phy)
+{
+	struct mt7915_dev *dev = phy->dev;
+	struct mt7915_hold_monitor *hold = &dev->hold;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	/* Ordinary background CAC with hold disabled keeps its old behavior. */
+	if (!cfg80211_hold_token_v2(phy->mt76->hw->wiphy, &hold->token))
+		return;
+	hold->phy = phy;
+	hold->at_us = 0;
+	hold->sequence = 0;
+	hold->active = true;
+	mod_delayed_work(system_wq, &hold->work,
+			 msecs_to_jiffies(MANET_HOLD_POLL_MS));
+}
