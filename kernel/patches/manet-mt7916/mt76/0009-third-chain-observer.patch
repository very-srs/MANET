+static int
+mt7915_mcu_ipi_decode(const void *data, size_t len, u8 index, u8 band,
+		      struct mt7915_ipi_sample *sample)
+{
+	const struct mt7915_mcu_ipi_reply *reply = data;
+	int i;
+
+	if (len != sizeof(*reply))
+		return -EMSGSIZE;
+	if (reply->index != index || reply->band != band)
+		return -EPROTO;
+
+	for (i = 0; i < ARRAY_SIZE(sample->bins); i++)
+		sample->bins[i] = le32_to_cpu(reply->bins[i]);
+	sample->tx_assert_us = le32_to_cpu(reply->tx_assert_us);
+
+	return 0;
+}
+
+int mt7915_mcu_ipi_query_index(struct mt7915_phy *phy, u8 index, u8 band,
+			       struct mt7915_ipi_sample *sample)
+{
+	struct mt7915_mcu_ipi_req req = {
+		.index = index,
+		.band = band,
+	};
+	struct sk_buff *skb;
+	int ret;
+
+	ret = mt76_mcu_send_and_get_msg(&phy->dev->mt76,
+					MCU_EXT_QUERY(RDD_IPI_HIST),
+					&req, sizeof(req), true, &skb);
+	if (!ret) {
+		ret = mt7915_mcu_ipi_decode(skb->data, skb->len, index, band, sample);
+		dev_kfree_skb(skb);
+	}
+
+	return ret;
 }
 
