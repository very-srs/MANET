diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c b/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c
--- a/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c
@@ -9,6 +9,56 @@
 static bool enable_6ghz;
 module_param(enable_6ghz, bool, 0644);
 MODULE_PARM_DESC(enable_6ghz, "Enable 6 GHz instead of 5 GHz on hardware that supports both");
+
+static bool background_radar_2t2r;
+module_param(background_radar_2t2r, bool, 0444);
+MODULE_PARM_DESC(background_radar_2t2r,
+		 "Reserve MT7916 band-1 third RX path for background radar");
+
+static int mt7915_eeprom_reserve_background_rx(struct mt7915_dev *dev)
+{
+	u8 *eeprom = dev->mt76.eeprom.data;
+	u8 band0 = eeprom[MT_EE_WIFI_CONF];
+	u8 band1 = eeprom[MT_EE_WIFI_CONF + 1];
+	u8 nss = u8_get_bits(eeprom[MT_EE_WIFI_CONF + 3],
+			     MT_EE_WIFI_CONF_STREAM_NUM);
+	u8 tx = u8_get_bits(band1, MT_EE_WIFI_CONF0_TX_PATH);
+	u8 sel1 = u8_get_bits(band1, MT_EE_WIFI_CONF0_BAND_SEL);
+
+	if (!background_radar_2t2r || !is_mt7916(&dev->mt76))
+		return 0;
+
+	/* Only the 2 GHz 2T2R + 5 GHz 3-RX DBDC layout is supported.
+	 * A 5/6 GHz selectable band 1 runs as 5 GHz unless enable_6ghz.
+	 */
+	if (!dev->dbdc_support ||
+	    u8_get_bits(band0, MT_EE_WIFI_CONF0_BAND_SEL) !=
+		MT_EE_V2_BAND_SEL_2GHZ ||
+	    u8_get_bits(band0, MT_EE_WIFI_CONF0_TX_PATH) != 2 ||
+	    u8_get_bits(band0, MT_EE_WIFI_CONF0_RX_PATH) != 2 ||
+	    (sel1 != MT_EE_V2_BAND_SEL_5GHZ &&
+	     (sel1 != MT_EE_V2_BAND_SEL_5GHZ_6GHZ || enable_6ghz)) ||
+	    u8_get_bits(band1, MT_EE_WIFI_CONF0_RX_PATH) != 3 ||
+	    (tx != 2 && tx != 3) || nss == 1) {
+		dev_err(dev->mt76.dev,
+			"background_radar_2t2r: unsupported EEPROM layout\n");
+		return -EINVAL;
+	}
+
+	/* Change only the RAM image, never efuse or calibration bytes. */
+	u8p_replace_bits(&eeprom[MT_EE_WIFI_CONF + 1], 2,
+			 MT_EE_WIFI_CONF0_TX_PATH);
+	u8p_replace_bits(&eeprom[MT_EE_WIFI_CONF + 1], 2,
+			 MT_EE_WIFI_CONF0_RX_PATH);
+	u8p_replace_bits(&eeprom[MT_EE_WIFI_CONF + 3], 2,
+			 MT_EE_WIFI_CONF_STREAM_NUM);
+	dev->flash_mode = true;
+	dev->background_rx_reserved = true;
+	dev_info(dev->mt76.dev,
+		 "band 1: 2T2R background RX reservation\n");
+
+	return 0;
+}
 
