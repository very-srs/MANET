From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MANET <manet@localhost>
Date: Wed, 7 Oct 2026 12:00:00 -0600
Subject: [PATCH 1/3] mt76: mt7915: expose opt-in MT7916 timing reports

Add the MT7916 timing MCU control and band identity registers in debugfs.
Prepare band 1 timing clocks only on explicit enable and expose raw reports
through a disabled-by-default tracepoint.

---
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/Makefile b/drivers/net/wireless/mediatek/mt76/mt7915/Makefile
--- a/drivers/net/wireless/mediatek/mt76/mt7915/Makefile
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/Makefile
@@ -3,7 +3,9 @@
 obj-$(CONFIG_MT7915E) += mt7915e.o
 
 mt7915e-y := pci.o init.o dma.o eeprom.o main.o mcu.o mac.o \
-	     debugfs.o mmio.o
+	     debugfs.o mmio.o tmr_trace.o
+
+CFLAGS_tmr_trace.o := -I$(src)
 
 mt7915e-$(CONFIG_NL80211_TESTMODE) += testmode.o
 mt7915e-$(CONFIG_MT798X_WMAC) += soc.o
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c b/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
--- a/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
@@ -1225,6 +1225,135 @@
 DEFINE_DEBUGFS_ATTRIBUTE(fops_rf_regval, mt7915_rf_regval_get,
 			 mt7915_rf_regval_set, "0x%08llx\n");
 
+static int mt7915_tmr_registers_show(struct seq_file *s, void *data)
+{
+	struct mt7915_phy *phy = s->private;
+	struct mt7915_dev *dev = phy->dev;
+	u8 band = phy->mt76->band_idx;
+	u32 reg, value;
+	int i, ret = 0;
+
+	/* Offsets below are specific to MT7916, not MT7915 or MT798x. */
+	if (!is_mt7916(&dev->mt76) || band > 1)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&dev->mt76.mutex);
+	if (!test_bit(MT76_STATE_RUNNING, &phy->mt76->state) ||
+	    test_bit(MT76_RESET, &dev->mphy.state) ||
+	    test_bit(MT76_MCU_RESET, &dev->mphy.state)) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	seq_printf(s, "chip=0x7916 band=%u\n", band);
+	for (i = 0; i < 4; i++) {
+		reg = MT_WF_RMAC(band, 0x60 + 4 * i);
+		value = mt76_rr(dev, reg);
+		seq_printf(s, "0x%08x=0x%08x\n", reg, value);
+	}
+out:
+	mutex_unlock(&dev->mt76.mutex);
+	return ret;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7915_tmr_registers);
+
+/*
+ * Band-1 TOAE preparation, MT7916 only (addresses verified on that band
+ * alone): enable the timing clocks before the first report and clear stale
+ * accelerator triggers with a reset pulse. Caller holds the mutex.
+ */
+#define MT7916_TOAE_CLK0	0x83180004
+#define MT7916_TOAE_CLK1	0x83180008
+#define MT7916_TOAE_CLK_EN	BIT(10)
+#define MT7916_TOAE_CTRL	0x831a5bc4
+#define MT7916_TOAE_TRIGGERS	0x0002f000
+#define MT7916_TOAE_RESET	BIT(17)
+
+static void mt7915_tmr_prepare(struct mt7915_phy *phy)
+{
+	struct mt7915_dev *dev = phy->dev;
+	u32 val;
+
+	if (!is_mt7916(&dev->mt76) || phy->mt76->band_idx != 1)
+		return;
+
+	mt76_set(dev, MT7916_TOAE_CLK0, MT7916_TOAE_CLK_EN);
+	mt76_set(dev, MT7916_TOAE_CLK1, MT7916_TOAE_CLK_EN);
+
+	val = mt76_rr(dev, MT7916_TOAE_CTRL) & ~MT7916_TOAE_TRIGGERS;
+	mt76_wr(dev, MT7916_TOAE_CTRL, val);
+	mt76_wr(dev, MT7916_TOAE_CTRL, val | MT7916_TOAE_RESET);
+	mt76_wr(dev, MT7916_TOAE_CTRL, val);
+}
+
+/* Vendor EXT_CMD_ID_TMR_CTRL; absent from mt76. Sent without a response. */
+#define MCU_EXT_CMD_TMR_CTRL	0x44
+
+struct mt7915_tmr_ctrl_req {
+	u8 ctrl_type;		/* 0: enable configuration */
+	u8 version;
+	u8 threshold;
+	u8 iterations;
+	u8 enable;
+	u8 role;		/* 0: initiator (TX timing), 1: responder (RX) */
+	u8 category;
+	u8 band;
+	u8 type_subtype[4];
+} __packed;
+
+/*
+ * Write "enable role version category f0 f1 f2 f3 [threshold iterations]",
+ * numbers in any C base. The band is this PHY's. This control is write-only.
+ */
+static ssize_t mt7915_tmr_ctrl_write(struct file *file, const char __user *ubuf,
+				     size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	struct mt7915_dev *dev = phy->dev;
+	struct mt7915_tmr_ctrl_req req = {};
+	unsigned int v[10] = { [8] = 8, [9] = 10 };
+	char buf[96];
+	int n, ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	n = sscanf(buf, "%i %i %i %i %i %i %i %i %i %i", &v[0], &v[1], &v[2],
+		   &v[3], &v[4], &v[5], &v[6], &v[7], &v[8], &v[9]);
+	if (n != 8 && n != 10)
+		return -EINVAL;
+
+	req.enable = v[0];
+	req.role = v[1];
+	req.version = v[2];
+	req.category = v[3];
+	for (n = 0; n < 4; n++)
+		req.type_subtype[n] = v[4 + n];
+	req.threshold = v[8];
+	req.iterations = v[9];
+	req.band = phy->mt76->band_idx;
+
+	mutex_lock(&dev->mt76.mutex);
+	if (req.enable)
+		mt7915_tmr_prepare(phy);
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(TMR_CTRL), &req,
+				sizeof(req), false);
+	mutex_unlock(&dev->mt76.mutex);
+
+	dev_info(dev->mt76.dev, "TMR ctrl band %u: %*phN -> %d\n",
+		 req.band, (int)sizeof(req), &req, ret);
+	return ret ? ret : count;
+}
+
+static const struct file_operations mt7915_tmr_ctrl_fops = {
+	.write = mt7915_tmr_ctrl_write,
+	.open = simple_open,
+	.llseek = default_llseek,
+};
+
 int mt7915_init_debugfs(struct mt7915_phy *phy)
 {
 	struct mt7915_dev *dev = phy->dev;
@@ -1234,6 +1363,12 @@
 	dir = mt76_register_debugfs_fops(phy->mt76, NULL);
 	if (!dir)
 		return -ENOMEM;
+	if (is_mt7916(&dev->mt76)) {
+		debugfs_create_file("tmr_registers", 0400, dir, phy,
+				    &mt7915_tmr_registers_fops);
+		debugfs_create_file("tmr_ctrl", 0200, dir, phy,
+				    &mt7915_tmr_ctrl_fops);
+	}
 	debugfs_create_file("muru_debug", 0600, dir, dev, &fops_muru_debug);
 	debugfs_create_file("muru_stats", 0400, dir, phy,
 			    &mt7915_muru_stats_fops);
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/mac.c b/drivers/net/wireless/mediatek/mt76/mt7915/mac.c
--- a/drivers/net/wireless/mediatek/mt76/mt7915/mac.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/mac.c
@@ -8,6 +8,7 @@
 #include "../dma.h"
 #include "mac.h"
 #include "mcu.h"
+#include "tmr_trace.h"
 
 #define to_rssi(field, rcpi)	((FIELD_GET(field, rcpi) - 220) / 2)
 
@@ -1058,6 +1059,11 @@
 	type = le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE);
 
 	switch (type) {
+	case PKT_TYPE_RX_TMR:
+		/* Preserve the raw timing report for userspace. */
+		trace_mt7915_rx_tmr(dev, q, skb);
+		dev_kfree_skb(skb);
+		break;
 	case PKT_TYPE_TXRX_NOTIFY:
 		mt7915_mac_tx_free(dev, skb->data, skb->len);
 		napi_consume_skb(skb, 1);
@@ -1088,6 +1094,7 @@
 		}
 		fallthrough;
 	default:
+		/* Includes unknown RX formats and normal packets rejected above. */
 		dev_kfree_skb(skb);
 		break;
 	}
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/tmr_trace.c b/drivers/net/wireless/mediatek/mt76/mt7915/tmr_trace.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/tmr_trace.c
@@ -0,0 +1,5 @@
+// SPDX-License-Identifier: ISC
+#include "mt7915.h"
+
+#define CREATE_TRACE_POINTS
+#include "tmr_trace.h"
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/tmr_trace.h b/drivers/net/wireless/mediatek/mt76/mt7915/tmr_trace.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/tmr_trace.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: ISC */
+#if !defined(__MT7915_TMR_TRACE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define __MT7915_TMR_TRACE_H
+
+#include <linux/tracepoint.h>
+#include "mt7915.h"
+
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM mt7915
+
+/* Raw diagnostic bytes, not an interpretation of the hardware timestamps. */
+#define MT7915_TMR_CAPTURE_LEN 128
+
+DECLARE_EVENT_CLASS(mt7915_raw_report,
+	TP_PROTO(struct mt7915_dev *dev, int queue, struct sk_buff *skb),
+	TP_ARGS(dev, queue, skb),
+	TP_STRUCT__entry(
+		__string(device, dev_name(dev->mt76.dev))
+		__field(int, queue)
+		__field(unsigned int, len)
+		__field(unsigned int, captured)
+		__field(int, copy_error)
+		__dynamic_array(u8, data,
+			       min_t(unsigned int, skb->len,
+				     MT7915_TMR_CAPTURE_LEN))
+	),
+	TP_fast_assign(
+		__assign_str(device);
+		__entry->queue = queue;
+		__entry->len = skb->len;
+		__entry->captured = min_t(unsigned int, skb->len,
+					MT7915_TMR_CAPTURE_LEN);
+		memset(__get_dynamic_array(data), 0, __entry->captured);
+		__entry->copy_error = skb_copy_bits(skb, 0,
+						 __get_dynamic_array(data),
+						 __entry->captured);
+	),
+	TP_printk("dev=%s queue=%d len=%u captured=%u copy_error=%d data=%s",
+		  __get_str(device), __entry->queue, __entry->len,
+		  __entry->captured, __entry->copy_error,
+		  __print_hex(__get_dynamic_array(data), __entry->captured))
+);
+
+DEFINE_EVENT(mt7915_raw_report, mt7915_rx_tmr,
+	TP_PROTO(struct mt7915_dev *dev, int queue, struct sk_buff *skb),
+	TP_ARGS(dev, queue, skb)
+);
+
+#endif
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH .
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE tmr_trace
+
+#include <trace/define_trace.h>
-- 
2.43.0
