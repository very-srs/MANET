From: MANET maintainers
Subject: [PATCH] mt7915: advertise background CAC for runtime reservation

Native three-path EEPROM can reserve band 1 at runtime while keeping two
NSS. Advertise that capability before wiphy registration, retaining the DT
opt-out. Require the host to reserve before CAC, returning EBUSY without
changing ownership, rate limits or the failed-transition latch. Teardown
remains possible regardless of reservation state.

diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c b/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c
--- a/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/eeprom.c
@@ -417,6 +417,24 @@
 	return val & MT_EE_RATE_DELTA_SIGN ? delta : -delta;
 }
 
+/* Registration-time capability only. The runtime transition still checks
+ * the live mesh, channel, owners and its reversal deadline under the locks.
+ */
+bool mt7915_eeprom_can_reserve_background_radar(struct mt7915_phy *phy)
+{
+	struct mt7915_dev *dev = phy->dev;
+	struct mt76_phy *mphy = phy->mt76;
+	u8 *eeprom = dev->mt76.eeprom.data;
+
+	return IS_ENABLED(CONFIG_DEBUG_FS) &&
+	       is_mt7916(&dev->mt76) && mphy->band_idx == MT_BAND1 &&
+	       dev->chainshift == 2 && dev->chainmask == 0x1f &&
+	       mphy->antenna_mask == 3 && !dev->ibf &&
+	       eeprom[MT_EE_WIFI_CONF + 1] == 0x5b &&
+	       u8_get_bits(eeprom[MT_EE_WIFI_CONF + 3],
+			   MT_EE_WIFI_CONF_STREAM_NUM) == 2;
+}
+
 bool
 mt7915_eeprom_has_background_radar(struct mt7915_dev *dev)
 {
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/init.c b/drivers/net/wireless/mediatek/mt76/mt7915/init.c
--- a/drivers/net/wireless/mediatek/mt76/mt7915/init.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/init.c
@@ -398,7 +398,8 @@
 	if (!is_mt7915(&dev->mt76))
 		wiphy_ext_feature_set(wiphy, NL80211_EXT_FEATURE_STA_TX_PWR);
 
-	if (mt7915_eeprom_has_background_radar(phy->dev) &&
+	if ((mt7915_eeprom_has_background_radar(phy->dev) ||
+	     mt7915_eeprom_can_reserve_background_radar(phy)) &&
 	    (!dev->background_rx_reserved || mphy->band_idx == MT_BAND1) &&
 	    (!mdev->dev->of_node ||
 	     !of_property_read_bool(mdev->dev->of_node,
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/main.c b/drivers/net/wireless/mediatek/mt76/mt7915/main.c
--- a/drivers/net/wireless/mediatek/mt76/mt7915/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/main.c
@@ -1727,10 +1727,28 @@
 	bool running;
 
 	mutex_lock(&dev->mt76.mutex);
-	if (chandef && (!dev->background_rx_reserved ||
-	    phy->mt76->band_idx != MT_BAND1)) {
-		ret = -EOPNOTSUPP;
-		goto out;
+	if (chandef) {
+		if (phy->mt76->band_idx != MT_BAND1) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+		/* Failed transitions remain latched until module reload. */
+		if (dev->rx_probe_failed) {
+			ret = -EBUSY;
+			goto out;
+		}
+		/* The host must reserve first through rx_transition_probe.
+		 * Never bypass its ownership checks or 60-second reversal limit.
+		 */
+		if (!dev->background_rx_reserved) {
+			ret = mt7915_eeprom_can_reserve_background_radar(phy) ?
+			      -EBUSY : -EOPNOTSUPP;
+			goto out;
+		}
+		if (phy->mt76->chainmask != 0x0c) {
+			ret = -EBUSY;
+			goto out;
+		}
 	}
 
 	if (dev->bg_scan.dirty && dev->bg_scan.borrowed)
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h b/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h
--- a/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/mt7915.h
@@ -517,6 +517,7 @@
 				   u8 chain_idx);
 s8 mt7915_eeprom_get_power_delta(struct mt7915_dev *dev, int band);
 bool mt7915_eeprom_has_background_radar(struct mt7915_dev *dev);
+bool mt7915_eeprom_can_reserve_background_radar(struct mt7915_phy *phy);
 int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2);
 void mt7915_dma_prefetch(struct mt7915_dev *dev);
 void mt7915_dma_cleanup(struct mt7915_dev *dev);
