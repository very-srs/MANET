+/* Apply the peer's tx_paths mode. The rate records built from the mode
+ * carry its stream and STBC limits; rebuilding them restores the
+ * firmware's default SPE. rebuild = true makes a complete transaction,
+ * and only a complete one clears tx_paths_failed. Callers that have just
+ * rebuilt the records pass false to send the SPE alone.
+ */
+int mt7915_mcu_set_tx_paths(struct mt7915_dev *dev, struct ieee80211_vif *vif,
+			    struct ieee80211_sta *sta, bool rebuild)
+{
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+	int ret = 0;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+
+	if (rebuild)
+		ret = mt7915_mcu_add_rate_ctrl(dev, vif, sta, true);
+
+	/* SPE 0 maps each stream to its own band-local path: path 0 is
+	 * chip chain 2 on band 1, the chain ranging uses. The MANET WM stores
+	 * this as a tagged per-peer override for the transmit command; stock
+	 * WM instead pins the peer to a fixed rate profile.
+	 */
+	if (!ret && msta->tx_paths != MT7915_TX_PATHS_FULL && dev->peer_spe) {
+		u8 spe = 0;
+
+		ret = mt7915_mcu_set_fixed_rate_ctrl(dev, vif, sta, &spe,
+						     RATE_PARAM_SPE_UPDATE);
+	}
+
+	if (ret) {
+		msta->tx_paths_failed = true;
+		dev_warn_ratelimited(dev->mt76.dev,
+				     "station %pM tx_paths %u not applied: %d\n",
+				     sta->addr, msta->tx_paths, ret);
+	} else if (rebuild) {
+		msta->tx_paths_failed = false;
+	}
+
+	return ret;
+}
+
+/* Set one station's mode. The caller holds dev->mt76.mutex, which
+ * mt76_sta_remove() takes before a station is freed, so sta stays valid.
+ * MT7915_TX_PATHS_AUTO hands a hand-set peer back to the policy, which
+ * only chooses full or dual: a single peer returns to full first.
+ */
+int mt7915_set_sta_tx_paths(struct mt7915_dev *dev, struct ieee80211_vif *vif,
+			    struct ieee80211_sta *sta, u8 mode, bool manual)
+{
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+
+	if (mode != MT7915_TX_PATHS_FULL && mode != MT7915_TX_PATHS_AUTO &&
+	    !dev->peer_spe)
+		return -EOPNOTSUPP;
+
+	WRITE_ONCE(msta->tx_paths_manual, manual);
+	if (mode == MT7915_TX_PATHS_AUTO) {
+		if (msta->tx_paths != MT7915_TX_PATHS_SINGLE)
+			return 0;
+		mode = MT7915_TX_PATHS_FULL;
+	}
+
+	WRITE_ONCE(msta->tx_paths, mode);
+
+	return mt7915_mcu_set_tx_paths(dev, vif, sta, true);
+}
+
+struct mt7915_peer_lookup {
+	struct mt7915_phy *phy;
+	const u8 *addr;
+	struct ieee80211_sta *sta;
+	int matches;
+};
+
+static void mt7915_peer_lookup_sta(void *data, struct ieee80211_sta *sta)
+{
+	struct mt7915_peer_lookup *l = data;
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+
+	if (msta->vif->phy == l->phy && ether_addr_equal(sta->addr, l->addr)) {
+		l->sta = sta;
+		l->matches++;
+	}
+}
+
+/* Set one peer's mode by MAC on this phy. The caller holds
+ * dev->mt76.mutex. A MAC held by more than one local interface is refused
+ * rather than guessed.
+ */
+int mt7915_set_peer_tx_paths(struct mt7915_phy *phy, const u8 *addr, u8 mode,
+			     bool manual)
+{
+	struct mt7915_peer_lookup l = { .phy = phy, .addr = addr };
+	struct ieee80211_vif *vif;
+	struct mt7915_sta *msta;
+
+	lockdep_assert_held(&phy->dev->mt76.mutex);
+
+	ieee80211_iterate_stations_atomic(phy->mt76->hw,
+					  mt7915_peer_lookup_sta, &l);
+	if (!l.matches)
+		return -ENOENT;
+	if (l.matches > 1)
+		return -EINVAL;
+
+	msta = (struct mt7915_sta *)l.sta->drv_priv;
+	vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+
+	return mt7915_set_sta_tx_paths(phy->dev, vif, l.sta, mode, manual);
+}
