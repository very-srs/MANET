+#define MT7916_WM_SPE_BUILD	"20240823172741"
+#define MT7916_WM_SPE_HOOK	613458
+
+static bool mt7915_wm_has_peer_spe(const struct firmware *fw)
+{
+	static const u8 hook[] = { 0x48, 0x00, 0x88, 0xc0 };
+	const struct mt76_connac2_fw_trailer *hdr;
+
+	if (fw->size < sizeof(*hdr) ||
+	    fw->size <= MT7916_WM_SPE_HOOK + sizeof(hook))
+		return false;
+
+	hdr = (const void *)(fw->data + fw->size - sizeof(*hdr));
+	return !memcmp(hdr->build_date, MT7916_WM_SPE_BUILD,
+		       sizeof(MT7916_WM_SPE_BUILD) - 1) &&
+	       !memcmp(fw->data + MT7916_WM_SPE_HOOK, hook, sizeof(hook));
+}
