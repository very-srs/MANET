diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c b/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
index 47477ac..3efb073 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/debugfs.c
@@ -923,12 +923,38 @@ static void mt7915_peer_tx_paths_list(void *data, struct ieee80211_sta *sta)
 {
 	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
 	struct mt7915_tx_paths_list *list = data;
+	struct mt7915_dev *dev = msta->vif->phy->dev;
+	struct mt7915_peer_power p;
+	unsigned long stamp, retry_ms;
+	int signal;
+	u16 fc, index;
+	bool by_index;
+
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	p = msta->power;
+	stamp = msta->path_signal_jiffies;
+	signal = -(int)ewma_avg_signal_read(&msta->path_signal);
+	fc = msta->path_signal_fc;
+	index = msta->path_signal_index;
+	by_index = msta->path_signal_by_index;
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	retry_ms = p.backoff && time_before(jiffies, p.retry_at) ?
+		jiffies_to_msecs(p.retry_at - jiffies) : 0;
 
 	list->len += scnprintf(list->buf + list->len, list->size - list->len,
-			       "%pM %s%s%s\n", sta->addr,
+			       "%pM %s%s%s power=%d%s rate=%u/%u/%u samples=%u "
+			       "errors=%u baseline_q8=%u per=%u stable=%u retry_ms=%lu backoff_s=%u "
+			       "signal=%d age_ms=%ld src=%s raw=%u fc=%04x\n",
+			       sta->addr,
 			       mt7915_tx_paths_names[READ_ONCE(msta->tx_paths)],
 			       READ_ONCE(msta->tx_paths_manual) ? " manual" : "",
-			       READ_ONCE(msta->tx_paths_failed) ? " failed" : "");
+			       READ_ONCE(msta->tx_paths_failed) ? " failed" : "",
+			       p.limit, p.dirty ? " pending" : "",
+			       p.mcs, p.nss, p.bw, p.samples,
+			       p.errors, p.baseline_mcs, p.baseline_per, p.stable,
+			       retry_ms, p.backoff, signal,
+			       stamp ? (long)jiffies_to_msecs(jiffies - stamp) : -1L,
+			       !stamp ? "none" : by_index ? "index" : "TA", index, fc);
 }
 
 static ssize_t mt7915_peer_tx_paths_get(struct file *file,
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/mac.c b/drivers/net/wireless/mediatek/mt76/mt7915/mac.c
index 8ae0f0a..728e1f4 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7915/mac.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/mac.c
@@ -283,19 +283,21 @@ module_param(tx_paths_full_dbm, int, 0644);
 MODULE_PARM_DESC(tx_paths_full_dbm,
 		 "Received signal below which a mesh peer returns to full paths (below tx_paths_dual_dbm)");
 
-/* Sample the policy's link signal from the peer's own frames, at most four
+/* Sample both policies' signal from peer broadcast/management, at most four
  * times a second and only while the policy can act. Each sample is measured
  * on reception, so its age is known; an average whose last sample has
  * expired starts again rather than carrying old readings forward.
  */
 static void
 mt7915_mac_sample_path_signal(struct mt7915_dev *dev, struct mt7915_sta *msta,
-			      struct mt76_rx_status *status)
+			      struct mt76_rx_status *status, u16 fc, u16 index,
+			      bool by_index)
 {
 	unsigned long now = jiffies, last;
 	int signal;
 
-	if (!READ_ONCE(tx_paths_auto) || !dev->peer_spe)
+	if (!dev->peer_spe ||
+	    !(READ_ONCE(tx_paths_auto) || READ_ONCE(mt7915_txpower_auto)))
 		return;
 
 	/* unlocked first look: most frames fall inside the current slot */
@@ -315,10 +317,54 @@ mt7915_mac_sample_path_signal(struct mt7915_dev *dev, struct mt7915_sta *msta,
 			ewma_avg_signal_init(&msta->path_signal);
 		ewma_avg_signal_add(&msta->path_signal, -signal);
 		WRITE_ONCE(msta->path_signal_jiffies, now);
+		msta->path_signal_fc = fc;
+		msta->path_signal_index = index;
+		msta->path_signal_by_index = by_index;
 	}
 	spin_unlock_bh(&dev->mt76.sta_poll_lock);
 }
 
+struct mt7915_basic_signal {
+	struct mt7915_phy *phy;
+	struct mt76_rx_status *status;
+	const u8 *addr;
+	u16 fc, index;
+	bool by_index;
+};
+
+static bool
+mt7915_mac_sample_basic_peer(struct mt7915_basic_signal *s,
+			    struct mt7915_sta *msta)
+{
+	struct ieee80211_sta *sta;
+	struct ieee80211_vif *vif;
+
+	if (!msta || !msta->wcid.sta || msta->wcid.sta_disabled ||
+	    msta->vif->phy != s->phy)
+		return false;
+	sta = container_of((void *)msta, struct ieee80211_sta, drv_priv);
+	if (s->addr && !ether_addr_equal(sta->addr, s->addr))
+		return false;
+	vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+	if (vif->type != NL80211_IFTYPE_MESH_POINT)
+		return false;
+	mt7915_mac_sample_path_signal(s->phy->dev, msta, s->status,
+				     s->fc, s->index, s->by_index);
+	return true;
+}
+
+/* RX NAPI holds RCU. Hash lookup avoids a full station walk on each
+ * group frame whose raw WLAN index is invalid (common on MT7916).
+ */
+static void mt7915_mac_sample_basic(struct mt7915_basic_signal *s)
+{
+	struct ieee80211_sta *sta;
+
+	sta = ieee80211_find_sta_by_ifaddr(s->phy->mt76->hw, s->addr, NULL);
+	if (sta)
+		mt7915_mac_sample_basic_peer(s, (void *)sta->drv_priv);
+}
+
 static int
 mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 		   enum mt76_rxq_id q, u32 *info)
@@ -339,6 +385,9 @@ mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 	u8 remove_pad, amsdu_info;
 	u8 mode = 0, qos_ctl = 0;
 	struct mt7915_sta *msta = NULL;
+	struct mt7915_sta *signal_sta = NULL;
+	u8 signal_ta[ETH_ALEN];
+	bool signal_ta_valid = false;
 	u32 csum_status = *(u32 *)skb->cb;
 	bool hdr_trans;
 	u16 hdr_gap;
@@ -373,6 +422,15 @@ mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 
 	unicast = FIELD_GET(MT_RXD3_NORMAL_ADDR_TYPE, rxd3) == MT_RXD3_NORMAL_U2M;
 	idx = FIELD_GET(MT_RXD1_NORMAL_WLAN_IDX, rxd1);
+	/* Preserve the transmitter's raw index before nonunicast delivery
+	 * deliberately substitutes the local vif's group WCID.
+	 */
+	{
+		struct mt76_wcid *raw = mt76_wcid_ptr(dev, idx);
+
+		if (raw && raw->sta)
+			signal_sta = container_of(raw, struct mt7915_sta, wcid);
+	}
 	status->wcid = mt7915_rx_get_wcid(dev, idx, unicast);
 
 	if (status->wcid) {
@@ -422,6 +480,9 @@ mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 		fc = cpu_to_le16(FIELD_GET(MT_RXD6_FRAME_CONTROL, v0));
 		qos_ctl = FIELD_GET(MT_RXD8_QOS_CTL, v2);
 		seq_ctrl = FIELD_GET(MT_RXD8_SEQ_CTRL, v2);
+		/* Group 4 retains the over-air TA even after 802.3 translation. */
+		memcpy(signal_ta, (u8 *)rxd + 2, ETH_ALEN);
+		signal_ta_valid = true;
 
 		rxd += 4;
 		if ((u8 *)rxd - skb->data >= skb->len)
@@ -592,9 +653,45 @@ mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 	if (rxv && mode >= MT_PHY_TYPE_HE_SU && !(status->flag & RX_FLAG_8023))
 		mt76_connac2_mac_decode_he_radiotap(&dev->mt76, skb, rxv, mode);
 
-	if (rxv && unicast && msta && msta->wcid.sta &&
-	    !(status->flag & (RX_FLAG_ONLY_MONITOR | RX_FLAG_FAILED_FCS_CRC)))
-		mt7915_mac_sample_path_signal(dev, msta, status);
+	if (rxv && dev->peer_spe &&
+	    (READ_ONCE(tx_paths_auto) || READ_ONCE(mt7915_txpower_auto)) &&
+	    !(status->flag & (RX_FLAG_ONLY_MONITOR |
+				    RX_FLAG_FAILED_FCS_CRC))) {
+		bool basic = false;
+
+		if (status->flag & RX_FLAG_8023) {
+			/* A multicast Ethernet DA can have a unicast over-air RA
+			 * (multicast-to-unicast replication). That uses a peer cap.
+			 */
+			basic = !unicast && skb->len >= ETH_HLEN &&
+				is_multicast_ether_addr(skb->data);
+		} else {
+			struct ieee80211_hdr *hdr = mt76_skb_get_hdr(skb);
+
+			if ((u8 *)hdr + 24 <= skb_tail_pointer(skb)) {
+				basic = ieee80211_is_mgmt(fc) ||
+					(ieee80211_is_data(fc) &&
+					 is_multicast_ether_addr(hdr->addr1));
+				memcpy(signal_ta, hdr->addr2, ETH_ALEN);
+				signal_ta_valid = true;
+			}
+		}
+		if (basic) {
+			struct mt7915_basic_signal sample = {
+				.phy = phy, .status = status,
+				.addr = signal_ta_valid ? signal_ta : NULL,
+				.fc = status->flag & RX_FLAG_8023 ?
+					IEEE80211_FTYPE_DATA : le16_to_cpu(fc),
+				.index = idx, .by_index = true,
+			};
+
+			if (!mt7915_mac_sample_basic_peer(&sample, signal_sta) &&
+			    signal_ta_valid) {
+				sample.by_index = false;
+				mt7915_mac_sample_basic(&sample);
+			}
+		}
+	}
 
 	if (!status->wcid || !ieee80211_is_data_qos(fc))
 		return 0;
@@ -858,6 +955,8 @@ int mt7915_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 	/* skb_add clears the cb; its private bit then survives TXFREE and TXS. */
 	if (tmr)
 		mt76_tx_skb_cb(tx_info->skb)->flags |= MT7915_TX_CB_TMR;
+	else if (sta)
+		mt7915_power_tx_prepare(dev, sta, tx_info->skb);
 	mt7915_mac_write_txwi(mdev, txwi_ptr, tx_info->skb, wcid, pid, key,
 			      qid, 0);
 
@@ -1132,6 +1231,10 @@ static void mt7915_mac_add_txs_skb(struct mt7915_dev *dev,
 			!!(info->flags & IEEE80211_TX_STAT_ACK);
 		info->status.rates[0].idx = -1;
 
+		if (!(mt76_tx_skb_cb(skb)->flags & MT7915_TX_CB_TMR))
+			mt7915_power_tx_status(dev,
+				container_of((void *)wcid, struct ieee80211_sta,
+					     drv_priv), skb, txs_data);
 		if (!(mt76_tx_skb_cb(skb)->flags & MT7915_TX_CB_TMR))
 			mt76_connac2_mac_fill_txs(mdev, wcid, txs_data);
 		mt76_tx_status_skb_done(mdev, skb, &list);
@@ -2186,7 +2289,7 @@ struct mt7915_tx_paths_scan {
 /* Runs in the atomic station iteration: only decide, never program.
  * mac_work holds dev->mt76.mutex across the scan and the apply, so the
  * stations collected here cannot be freed in between. The signal is that
- * of the peer's unicast frames as the peer currently sends them.
+ * of the peer's broadcast/management frames, outside peer data caps.
  */
 static void mt7915_tx_paths_scan_sta(void *data, struct ieee80211_sta *sta)
 {
@@ -2307,6 +2410,8 @@ void mt7915_mac_work(struct work_struct *work)
 		if (READ_ONCE(tx_paths_auto) && phy->dev->peer_spe)
 			mt7915_mac_tx_paths_policy(phy);
 	}
+	/* Guard/disable cleanup runs on every watchdog pass, including stock WM. */
+	mt7915_power_work(phy);
 
 	mutex_unlock(&mphy->dev->mutex);
 
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/main.c b/drivers/net/wireless/mediatek/mt76/mt7915/main.c
index f888096..fa1bfad 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7915/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/main.c
@@ -817,6 +817,7 @@ int mt7915_mac_sta_add(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 
 	ewma_avg_signal_init(&msta->avg_ack_signal);
 	ewma_avg_signal_init(&msta->path_signal);
+	mt7915_power_init(dev, sta);
 
 	mt7915_mac_wtbl_update(dev, idx,
 			       MT_WTBL_UPDATE_ADM_COUNT_CLEAR);
@@ -885,20 +886,16 @@ static void mt7915_sta_reapply(struct mt7915_dev *dev,
 			       struct ieee80211_vif *vif,
 			       struct ieee80211_sta *sta, bool rebuild)
 {
-	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
 	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
 	int ret;
 
 	lockdep_assert_held(&dev->mt76.mutex);
 
-	if (sta->deflink.txpwr.type == NL80211_TX_POWER_LIMITED) {
-		ret = mt7915_mcu_set_txpower_frame(mvif->phy, vif, sta,
-						   sta->deflink.txpwr.power);
-		if (ret)
-			dev_warn(dev->mt76.dev,
-				 "station %pM power limit not applied: %d\n",
-				 sta->addr, ret);
-	}
+	ret = mt7915_power_reapply(dev, vif, sta);
+	if (ret)
+		dev_warn_ratelimited(dev->mt76.dev,
+				     "station %pM power not reapplied: %d\n",
+				     sta->addr, ret);
 	mt7915_mcu_set_tx_paths(dev, vif, sta,
 				rebuild && msta->tx_paths != MT7915_TX_PATHS_FULL);
 }
@@ -913,6 +910,7 @@ int mt7915_mac_sta_event(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 
 	switch (ev) {
 	case MT76_STA_EVENT_ASSOC:
+		mt7915_power_init(dev, sta);
 		/* peer_tx_paths writers hold this mutex: build the records and
 		 * reapply under it so they all see one transmit-path mode
 		 */
@@ -954,6 +952,7 @@ int mt7915_mac_sta_event(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 		msta->wcid.tx_info &= ~MT_WCID_TX_INFO_SET;
 		msta->wcid.sta_disabled = 1;
 		msta->wcid.sta = 0;
+		mt7915_power_invalidate(dev, sta);
 		return 0;
 	}
 
@@ -1426,6 +1425,8 @@ static int mt7915_sta_set_txpwr(struct ieee80211_hw *hw,
 		txpower = 0;
 
 	mutex_lock(&dev->mt76.mutex);
+	/* A user limit owns the station; AUTO explicitly starts a new trial. */
+	mt7915_power_init(dev, sta);
 
 	/* NOTE: temporarily use 0 as minimum limit, which is a
 	 * global setting and will be applied to all stations.
@@ -1439,6 +1440,13 @@ static int mt7915_sta_set_txpwr(struct ieee80211_hw *hw,
 	 * using fixed rate can be configured via TxD.
 	 */
 	ret = mt7915_mcu_set_txpower_frame(phy, vif, sta, txpower);
+	if (!ret) {
+		struct mt7915_sta *msta = (void *)sta->drv_priv;
+
+		spin_lock_bh(&dev->mt76.sta_poll_lock);
+		msta->power.dirty = false;
+		spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	}
 
 out:
 	mutex_unlock(&dev->mt76.mutex);
diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/mcu.c b/drivers/net/wireless/mediatek/mt76/mt7915/mcu.c
index 8e077c3..e0dc335 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7915/mcu.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/mcu.c
@@ -1510,6 +1510,7 @@ int mt7915_mcu_set_tx_paths(struct mt7915_dev *dev, struct ieee80211_vif *vif,
 	int ret = 0;
 
 	lockdep_assert_held(&dev->mt76.mutex);
+	mt7915_power_invalidate(dev, sta);
 
 	if (rebuild)
 		ret = mt7915_mcu_add_rate_ctrl(dev, vif, sta, true);
@@ -3585,7 +3586,8 @@ int mt7915_mcu_set_txpower_frame_min(struct mt7915_phy *phy, s8 txpower)
 				 sizeof(req), true);
 }
 
-int mt7915_mcu_set_txpower_frame(struct mt7915_phy *phy,
+/* Explicit controller limit; -1 clears without changing mac80211 ownership. */
+int mt7915_mcu_set_txpower_limit(struct mt7915_phy *phy,
 				 struct ieee80211_vif *vif,
 				 struct ieee80211_sta *sta, s16 txpower)
 {
@@ -3608,19 +3610,23 @@ int mt7915_mcu_set_txpower_frame(struct mt7915_phy *phy,
 	int ret;
 	s8 txpower_sku[MT7915_SKU_RATE_NUM];
 
-	ret = mt7915_mcu_get_txpower_sku(phy, txpower_sku, sizeof(txpower_sku));
-	if (ret)
-		return ret;
+	if (txpower < -1)
+		return -EINVAL;
 
 	/* An all-zero offset table clears the station's limit; only an
 	 * explicit limit is converted and range-checked.
 	 */
-	if (sta->deflink.txpwr.type != NL80211_TX_POWER_AUTOMATIC) {
+	if (txpower >= 0) {
 		u32 offs, len, i;
 		int target;
 
+		ret = mt7915_mcu_get_txpower_sku(phy, txpower_sku,
+					      sizeof(txpower_sku));
+		if (ret)
+			return ret;
+
 		/* mt76_get_power_bound() doubles the limit into an s8 */
-		if (txpower < 0 || txpower > S8_MAX / 2)
+		if (txpower > S8_MAX / 2)
 			return -EINVAL;
 
 		/* The firmware keeps a rate's base power when the offset would
@@ -3666,6 +3672,17 @@ int mt7915_mcu_set_txpower_frame(struct mt7915_phy *phy,
 				 sizeof(req), true);
 }
 
+int mt7915_mcu_set_txpower_frame(struct mt7915_phy *phy,
+			       struct ieee80211_vif *vif,
+			       struct ieee80211_sta *sta, s16 txpower)
+{
+	if (sta->deflink.txpwr.type == NL80211_TX_POWER_AUTOMATIC)
+		txpower = -1;
+	else if (txpower < 0)
+		return -EINVAL;
+	return mt7915_mcu_set_txpower_limit(phy, vif, sta, txpower);
+}
+
 int mt7915_mcu_set_txpower_sku(struct mt7915_phy *phy)
 {
 	struct mt7915_dev *dev = phy->dev;
