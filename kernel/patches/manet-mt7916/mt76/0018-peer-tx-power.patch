diff --git a/drivers/net/wireless/mediatek/mt76/mt7915/power.c b/drivers/net/wireless/mediatek/mt76/mt7915/power.c
new file mode 100644
index 0000000..4247609
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7915/power.c
@@ -0,0 +1,461 @@
+// SPDX-License-Identifier: ISC
+/* Local basic-frame signal caps. No peer signalling or interface restart. */
+#include "mt7915.h"
+#include "mac.h"
+#include "mcu.h"
+
+bool mt7915_txpower_auto = true;
+module_param_named(tx_power_auto, mt7915_txpower_auto, bool, 0644);
+MODULE_PARM_DESC(tx_power_auto,
+	"Map mesh broadcast/management signal to data power with rollback (default on)");
+
+#define POWER_CLEAR -1
+#define POWER_NONE -2
+#define POWER_STEP 2
+#define POWER_WINDOW (5 * HZ)
+#define POWER_WINDOW_MAX (30 * HZ)
+#define POWER_RECOVER (10 * 60 * HZ)
+#define POWER_FRESH (2 * HZ)
+#define POWER_SIGNAL_AGE (10 * HZ)
+#define POWER_MIN_SAMPLES 16
+#define POWER_MCS_TOLERANCE 128 /* half an MCS, Q8 */
+#define POWER_PER_TOLERANCE 10 /* percentage points */
+#define POWER_RETRY_MIN 300 /* seconds */
+#define POWER_RETRY_MAX 3600
+
+enum mt7915_power_check {
+	POWER_KEEP,
+	POWER_SPARSE,
+	POWER_REGRESSION,
+};
+
+/* Compare complete windows to the peer's uncapped behaviour, not its
+ * highest individual completion. All helpers run under sta_poll_lock.
+ */
+static void mt7915_power_window_reset(struct mt7915_peer_power *p,
+				    unsigned long now)
+{
+	p->window_start = now;
+	p->sum_mcs = 0;
+	p->samples = 0;
+	p->errors = 0;
+	p->mismatches = 0;
+}
+
+static void mt7915_power_backoff(struct mt7915_peer_power *p, unsigned long now)
+{
+	p->backoff = p->backoff ? min_t(u16, 2 * p->backoff, POWER_RETRY_MAX) :
+				POWER_RETRY_MIN;
+	p->retry_at = now + p->backoff * HZ;
+}
+
+static enum mt7915_power_check
+mt7915_power_window(struct mt7915_peer_power *p, unsigned long now)
+{
+	enum mt7915_power_check result = POWER_KEEP;
+	u16 mean, per;
+	bool bad;
+
+	if (time_before(now, p->window_start + POWER_WINDOW))
+		return POWER_KEEP;
+	p->qualified = false;
+	/* Low traffic is not evidence of rate loss. Wait for enough samples
+	 * without permitting a deeper cap on an incomplete old window.
+	 */
+	if (p->samples < POWER_MIN_SAMPLES &&
+	    time_before(now, p->window_start + POWER_WINDOW_MAX))
+		return POWER_KEEP;
+	if (p->samples >= POWER_MIN_SAMPLES) {
+		u16 valid = p->samples - p->mismatches;
+
+		mean = valid ? p->sum_mcs * 256 / valid : 0;
+		per = p->errors * 100 / p->samples;
+		if (p->limit < 0) {
+			/* Two adjacent full-power windows must agree. There is
+			 * no absolute MCS floor: stable MCS8 can save power too.
+			 */
+			if (per <= 25) {
+				if (p->stable &&
+				    abs((int)mean - p->baseline_mcs) <= POWER_MCS_TOLERANCE &&
+				    abs((int)per - p->baseline_per) <= POWER_PER_TOLERANCE)
+					p->stable = 2;
+				else
+					p->stable = 1;
+			} else {
+				p->stable = 0;
+			}
+			p->baseline_mcs = mean;
+			p->baseline_per = per;
+			p->qualified = p->stable == 2;
+		} else {
+			bad = mean + POWER_MCS_TOLERANCE < p->baseline_mcs ||
+			      per > p->baseline_per + POWER_PER_TOLERANCE;
+			p->qualified = !bad;
+			if (bad) {
+				result = POWER_REGRESSION;
+			} else if (!time_before(now, p->changed + POWER_RECOVER)) {
+				/* Only a passing complete window confirms recovery;
+				 * uncapped time or an unfinished window earns nothing.
+				 */
+				p->backoff = 0;
+				p->retry_at = 0;
+			}
+		}
+	} else {
+		p->stable = 0;
+		/* The 30-second measurement timeout clears without penalty. */
+		result = p->limit >= 0 ? POWER_SPARSE : POWER_KEEP;
+	}
+	mt7915_power_window_reset(p, now);
+	return result;
+}
+
+void mt7915_power_init(struct mt7915_dev *dev, struct ieee80211_sta *sta)
+{
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	struct mt7915_peer_power *p = &msta->power;
+	u32 gen;
+	bool dirty;
+
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	gen = p->generation + 1;
+	dirty = p->generation && (p->limit >= 0 || p->dirty);
+	memset(p, 0, sizeof(*p));
+	p->generation = gen ?: 1;
+	p->limit = POWER_CLEAR;
+	p->dirty = dirty;
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+}
+
+void mt7915_power_invalidate(struct mt7915_dev *dev, struct ieee80211_sta *sta)
+{
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	struct mt7915_peer_power *p = &msta->power;
+
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	if (p->ready || p->limit >= 0) {
+		p->generation++;
+		p->ready = false;
+		/* An uncapped table needs no clear just to invalidate rates.
+		 * In particular, do not create cleanup work while disabled.
+		 */
+		p->dirty |= p->limit >= 0;
+		p->limit = POWER_CLEAR;
+		p->stable = 0;
+		p->qualified = false;
+	}
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+}
+
+void mt7915_power_tx_prepare(struct mt7915_dev *dev, struct ieee80211_sta *sta,
+			    struct sk_buff *skb)
+{
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_hdr *hdr = (void *)skb->data;
+	struct mt76_tx_cb *cb = mt76_tx_skb_cb(skb);
+
+	if (!READ_ONCE(mt7915_txpower_auto) || !dev->peer_spe ||
+	    cb->pktid < MT_PACKET_ID_FIRST ||
+	    info->flags & (IEEE80211_TX_CTL_RATE_CTRL_PROBE |
+			   IEEE80211_TX_CTL_NO_ACK) ||
+	    (!(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) &&
+	     !ieee80211_is_data_present(hdr->frame_control)))
+		return;
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	if (msta->power.ready)
+		cb->rate_generation = msta->power.generation;
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+}
+
+void mt7915_power_tx_status(struct mt7915_dev *dev, struct ieee80211_sta *sta,
+			   struct sk_buff *skb, __le32 *txs)
+{
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	struct mt7915_peer_power *p = &msta->power;
+	u32 cookie = mt76_tx_skb_cb(skb)->rate_generation;
+	u32 v = le32_to_cpu(txs[0]);
+	u32 rate = FIELD_GET(MT_TXS0_TX_RATE, v);
+	u8 mode = FIELD_GET(MT_TX_RATE_MODE, rate);
+	u8 nss = FIELD_GET(MT_TX_RATE_NSS, rate) + 1;
+	u8 mcs = FIELD_GET(MT_TX_RATE_IDX, rate);
+	bool he = mode == MT_PHY_TYPE_HE_SU || mode == MT_PHY_TYPE_HE_EXT_SU;
+
+	if (!cookie || !msta->wcid.sta)
+		return;
+	if (FIELD_GET(MT_TX_RATE_STBC, rate) && nss > 1)
+		nss >>= 1;
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	if (p->ready && cookie == p->generation) {
+		bool valid = he && mcs <= 11 && nss == p->nss &&
+			FIELD_GET(MT_TXS0_BW, v) == p->bw &&
+			!(rate & MT_TX_RATE_DCM);
+
+		if (p->samples < U16_MAX) {
+			p->samples++;
+			/* ACK errors are a ratio; invalid mode/NSS/BW also
+			 * counts as an error, outside the matching HE MCS mean.
+			 */
+			p->sum_mcs += valid ? mcs : 0;
+			p->mismatches += !valid;
+			p->errors += !valid || !!(v & MT_TXS0_ACK_ERROR_MASK);
+		}
+		p->mcs = mcs;
+		p->last_txs = jiffies;
+	}
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+}
+
+/* Device mutex held. All state transitions are under sta_poll_lock; never
+ * hold that spin lock across MCU traffic. Statuses from before/during an
+ * application have a different cookie and cannot qualify its new window.
+ */
+static int mt7915_power_apply(struct mt7915_dev *dev, struct ieee80211_vif *vif,
+			     struct ieee80211_sta *sta, s16 limit)
+{
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	struct mt7915_phy *phy = msta->vif->phy;
+	struct mt7915_peer_power *p = &msta->power;
+	int ret;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	if (limit >= 0 && (p->limit < 0 || limit < p->limit)) {
+		/* A status may have arrived since the atomic scan/decision. */
+		if (!p->qualified || !p->last_txs ||
+		    time_after(jiffies, p->last_txs + POWER_FRESH)) {
+			spin_unlock_bh(&dev->mt76.sta_poll_lock);
+			return -EAGAIN;
+		}
+	}
+	p->generation++;
+	p->ready = false;
+	p->limit = limit;
+	p->dirty = true;
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	ret = mt7915_mcu_set_txpower_frame_min(phy, 0);
+	if (!ret)
+		ret = mt7915_mcu_set_txpower_limit(phy, vif, sta, limit);
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	p->generation++;
+	p->dirty = !!ret;
+	p->ready = !ret;
+	p->changed = jiffies;
+	p->last_txs = 0;
+	p->qualified = false;
+	mt7915_power_window_reset(p, jiffies);
+	if (limit < 0 || ret)
+		p->stable = 0;
+	if (ret) {
+		/* Unknown effective limit: retry a clear, never a reduction.
+		 * Failed clear retries must not extend cooldown every pass.
+		 */
+		p->limit = POWER_CLEAR;
+		if (!p->backoff || !time_before(jiffies, p->retry_at))
+			mt7915_power_backoff(p, jiffies);
+	}
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	if (ret)
+		dev_warn_ratelimited(dev->mt76.dev, "peer %pM power %d failed: %d\n",
+				     sta->addr, limit, ret);
+	return ret;
+}
+
+int mt7915_power_reapply(struct mt7915_dev *dev, struct ieee80211_vif *vif,
+			struct ieee80211_sta *sta)
+{
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	s16 limit;
+	bool needed;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (sta->deflink.txpwr.type == NL80211_TX_POWER_LIMITED)
+		return mt7915_mcu_set_txpower_frame(msta->vif->phy, vif, sta,
+						   sta->deflink.txpwr.power);
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	limit = msta->power.limit;
+	needed = msta->power.dirty || limit >= 0;
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	return needed ? mt7915_power_apply(dev, vif, sta, limit) : 0;
+}
+
+/* Caller holds sta_poll_lock. POWER_NONE means no firmware transaction.
+ * The received management/broadcast signal selects a fixed cap. A
+ * sustained window regression clears it and schedules a timed retry.
+ * No downward power search or peer power estimate.
+ */
+static s16 mt7915_power_decide(struct mt7915_peer_power *p, unsigned long now,
+			     bool enabled, bool fresh, int signal)
+{
+	bool stale = !p->last_txs || time_after(now, p->last_txs + POWER_FRESH);
+	enum mt7915_power_check check;
+	s16 reduction, next;
+
+	if (!enabled) {
+		p->ready = false;
+		return p->limit >= 0 || p->dirty ? POWER_CLEAR : POWER_NONE;
+	}
+	if (p->dirty)
+		return p->limit;
+	if (stale) {
+		p->qualified = false;
+		if (p->limit >= 0 && time_after(now, p->changed + POWER_FRESH))
+			return POWER_CLEAR;
+		if (p->limit < 0) {
+			p->stable = 0;
+			mt7915_power_window_reset(p, now);
+		}
+	}
+	check = mt7915_power_window(p, now);
+	if (check != POWER_KEEP) {
+		if (check == POWER_REGRESSION)
+			mt7915_power_backoff(p, now);
+		return POWER_CLEAR;
+	}
+	if (!fresh)
+		return p->limit >= 0 ? POWER_CLEAR : POWER_NONE;
+	/* 2 dB bins above -48 dBm, maximum 8 dB attenuation, floor 10 dBm.
+	 * Matching rate/error windows qualify this signal-selected target.
+	 */
+	reduction = clamp_t(s16, (signal + 48) / POWER_STEP, 0, 4) * POWER_STEP;
+	if (p->limit >= 0 && reduction > p->base - p->limit)
+		reduction = max_t(s16, p->base - p->limit,
+			clamp_t(s16, (signal + 46) / POWER_STEP, 0, 4) * POWER_STEP);
+	next = reduction ? max_t(s16, 10, p->base - reduction) : POWER_CLEAR;
+	if (p->base <= 10 || next >= p->base)
+		next = POWER_CLEAR;
+	if (next == p->limit)
+		return POWER_NONE;
+	/* Raising power and disabling a cap never wait for a rate window. */
+	if (next < 0 || (p->limit >= 0 && next > p->limit))
+		return next;
+	if (stale || !p->qualified ||
+	    (p->backoff && time_before(now, p->retry_at)))
+		return POWER_NONE;
+	return next;
+}
+
+struct mt7915_power_scan {
+	struct mt7915_phy *phy;
+	struct ieee80211_sta *sta[8];
+	int n;
+	u16 start;
+	bool pending;
+};
+
+static s16 mt7915_power_target(struct mt7915_phy *phy, struct ieee80211_sta *sta)
+{
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	struct mt7915_peer_power *p = &msta->power;
+	struct mt76_phy *mphy = phy->mt76;
+	struct ieee80211_vif *vif = container_of((void *)msta->vif,
+						struct ieee80211_vif, drv_priv);
+	u8 nss = min_t(u8, sta->deflink.rx_nss, hweight8(mphy->antenna_mask));
+	s16 base = clamp_t(s16, (mphy->txpower_cur +
+		mt76_tx_power_path_delta(hweight16(mphy->chainmask))) / 2, 1, 63);
+	u16 freq = mphy->chandef.center_freq1;
+	bool enabled = READ_ONCE(mt7915_txpower_auto) && phy->dev->peer_spe &&
+		sta->deflink.he_cap.has_he && nss == 2 &&
+		msta->tx_paths != MT7915_TX_PATHS_SINGLE;
+	unsigned long stamp;
+	int signal;
+	s16 target;
+
+	if (msta->vif->phy != phy || vif->type != NL80211_IFTYPE_MESH_POINT ||
+	    !msta->wcid.sta || msta->wcid.sta_disabled ||
+	    sta->deflink.txpwr.type != NL80211_TX_POWER_AUTOMATIC)
+		return POWER_NONE;
+	spin_lock_bh(&phy->dev->mt76.sta_poll_lock);
+	if (enabled && ((!p->ready && !p->dirty) || p->freq != freq || p->base != base ||
+	    p->chains != mphy->chainmask || p->bw != sta->deflink.bandwidth ||
+	    p->paths != msta->tx_paths || p->nss != nss)) {
+		p->freq = freq;
+		p->base = base;
+		p->chains = mphy->chainmask;
+		p->bw = sta->deflink.bandwidth;
+		p->paths = msta->tx_paths;
+		p->nss = nss;
+		p->mcs = 0;
+		p->limit = POWER_CLEAR;
+		p->stable = 0;
+		p->qualified = false;
+		p->dirty = true;
+	}
+	stamp = msta->path_signal_jiffies;
+	signal = -(int)ewma_avg_signal_read(&msta->path_signal);
+	target = mt7915_power_decide(p, jiffies, enabled,
+		stamp && signal && !time_after(jiffies, stamp + POWER_SIGNAL_AGE), signal);
+	spin_unlock_bh(&phy->dev->mt76.sta_poll_lock);
+	return target;
+}
+
+static void mt7915_power_scan_sta(void *data, struct ieee80211_sta *sta)
+{
+	struct mt7915_power_scan *s = data;
+	struct mt7915_sta *msta = (void *)sta->drv_priv;
+	struct mt7915_dev *dev = s->phy->dev;
+	struct ieee80211_vif *vif;
+	unsigned int distance;
+	int i, j;
+
+	if (msta->vif->phy != s->phy || !msta->wcid.sta ||
+	    msta->wcid.sta_disabled ||
+	    sta->deflink.txpwr.type != NL80211_TX_POWER_AUTOMATIC)
+		return;
+	vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+	if (vif->type != NL80211_IFTYPE_MESH_POINT)
+		return;
+	/* This scan visits every eligible station, including entries outside
+	 * the bounded apply batch. Keep disable cleanup alive until drained.
+	 */
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	s->pending |= msta->power.limit >= 0 || msta->power.dirty;
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	/* The mac80211 list is not ordered by WCID. Retain the eight nearest
+	 * entries in circular WCID order, not the first eight list entries.
+	 */
+	distance = (msta->wcid.idx + MT7915_WTBL_STA - s->start) % MT7915_WTBL_STA;
+	for (i = 0; i < s->n; i++) {
+		struct mt7915_sta *other = (void *)s->sta[i]->drv_priv;
+		unsigned int d = (other->wcid.idx + MT7915_WTBL_STA - s->start) %
+				 MT7915_WTBL_STA;
+
+		if (distance < d)
+			break;
+	}
+	if (i == ARRAY_SIZE(s->sta))
+		return;
+	for (j = min_t(int, s->n, ARRAY_SIZE(s->sta) - 1); j > i; j--)
+		s->sta[j] = s->sta[j - 1];
+	s->sta[i] = sta;
+	if (s->n < ARRAY_SIZE(s->sta))
+		s->n++;
+}
+
+void mt7915_power_work(struct mt7915_phy *phy)
+{
+	struct mt7915_dev *dev = phy->dev;
+	struct mt7915_power_scan s = { .phy = phy, .start = phy->power_cursor };
+	int i;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!is_mt7916(&dev->mt76) ||
+	    (!READ_ONCE(mt7915_txpower_auto) && !phy->power_active))
+		return;
+	ieee80211_iterate_stations_atomic(phy->mt76->hw, mt7915_power_scan_sta, &s);
+	for (i = 0; i < s.n; i++) {
+		struct ieee80211_sta *sta = s.sta[i];
+		struct mt7915_sta *msta = (void *)sta->drv_priv;
+		struct ieee80211_vif *vif = container_of((void *)msta->vif,
+						struct ieee80211_vif, drv_priv);
+		s16 target = mt7915_power_target(phy, sta);
+
+		phy->power_cursor = (msta->wcid.idx + 1) % MT7915_WTBL_STA;
+		if (target != POWER_NONE)
+			mt7915_power_apply(dev, vif, sta, target);
+		spin_lock_bh(&dev->mt76.sta_poll_lock);
+		s.pending |= msta->power.limit >= 0 || msta->power.dirty;
+		spin_unlock_bh(&dev->mt76.sta_poll_lock);
+	}
+	phy->power_active = READ_ONCE(mt7915_txpower_auto) || s.pending;
+}
