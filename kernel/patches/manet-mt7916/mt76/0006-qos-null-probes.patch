+static bool mt7915_tmr_selected(struct mt7915_dev *dev,
+				struct ieee80211_sta *sta, struct sk_buff *skb)
+{
+	return skb == READ_ONCE(dev->tmr_probe_skb) || (!atomic_read(&dev->tmr_probe_busy) &&
+	      unlikely(READ_ONCE(dev->tmr_peer_set)) && sta &&
+	      ether_addr_equal(sta->addr, dev->tmr_peer) &&
+	      (!READ_ONCE(dev->tmr_mark) ||
+	       skb->mark == READ_ONCE(dev->tmr_mark)));
+}
+
+/* Single attempt and normal ACK regardless of the optional SPE override. */
+static void mt7915_tmr_probe_txwi(__le32 *txd)
+{
+	txd[3] |= cpu_to_le32(MT_TXD3_BA_DISABLE);
+	le32p_replace_bits(&txd[3], 1, MT_TXD3_REM_TX_COUNT);
+	txd[7] &= ~cpu_to_le32(MT_TXD7_HW_AMSDU);
+}
