+/* Re-run the CMD63 init sequence to bring SDIO back into SPI mode.
+ * Called after digital reset or during get_host_table_ptr polling when the
+ * chip's SDIO interface is offline (firmware reboot after CLK_CTRL/MSI). */
+static int morse_spi_reinit(struct morse *mors)
+{
+	struct morse_spi *mspi = (struct morse_spi *)mors->drv_priv;
+	int i, ret;
+
+	morse_spi_reset_base_address(mspi);
+	/* Do NOT send the power-on initsequence (74+ clocks) here: that is only
+	 * needed on cold power-up.  After digital_reset the chip is in native SDIO
+	 * mode; sending initsequence clocks with CS asserted confuses its SDIO
+	 * state machine before CMD63 can re-enter SPI mode. */
+	for (i = 0; i < 3; i++) {
+		ret = morse_spi_cmd(mspi, SD_IO_MORSE_INIT, 0x00000000);
+		if (!ret)
+			break;
+		morse_spi_cmd(mspi, SD_IO_RESET, 0x00000000);
+	}
+	return ret;
+}
