+	 * 0xFC = last 0xFF byte before chip asserts busy (0xFF→0x00 transition decoded)
+	 * 0x03 = last 0x00 busy byte before ACK token (0x00→0xC1 transition decoded)
+	 * Neither 0xFC nor 0x03 are valid SPI data response codes. */
+	while (cp < end && (*cp == 0xff || *cp == 0x00 || *cp == 0xfc || *cp == 0x03))
 		cp++;
 
 	if (cp == end)
 		goto exit;
 
+	/* If find_response's full-buffer deshift did not run (R1 came back
+	 * unshifted), the ACK token may carry the 2-bit MISO shift (0xC1 for
