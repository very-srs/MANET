#!/bin/bash
#
# Rock 3A Mesh Node Provisioning Script
# This script runs after network is available via systemd service
#

# Log the output of the provisioning script
exec > >(tee -a /var/log/mesh-provision.log) 2>&1
set -x
echo "=== Rock 3A provisioning starting at $(date) ==="

# Allow several client keys before password login during provisioning.
# radio-setup.sh rewrites this drop-in with the full SSH policy.
mkdir -p /etc/ssh/sshd_config.d
printf '%s\n' 'MaxAuthTries 10' > /etc/ssh/sshd_config.d/10-manet.conf
systemctl reload ssh 2>/dev/null || true

# Temporarily allow APT metadata from a system without a trusted clock.
# This runs in each provisioning phase, including retries. Signatures stay on.
cleanup_apt_clock_override() {
    rm -f /etc/apt/apt.conf.d/99no-time-checks.conf
}
trap 'cleanup_apt_clock_override || exit 1' EXIT
trap 'exit 1' HUP INT TERM
printf '%s\n' 'Acquire::Check-Date "false";' > /etc/apt/apt.conf.d/99no-time-checks.conf || exit 1
# End temporary APT clock setup.

# This is where the wifi regulatory country is set
REG="__REGULATORY_DOMAIN__"

# Calculate unique hostname from MAC address
HOST_MAC=$(ip a | grep -A1 $(networkctl | grep -v bat | awk '/ether/ {print $2}' | head -1) \
   | awk '/ether/ {print $2}' | cut -d':' -f 5-6 | sed 's/://g')


# Set hostname based on MAC
hostnamectl set-hostname "mesh-${HOST_MAC}"

BOOTSTRAP_LOG=/var/log/mesh-provision.log
# BEGIN bounded provisioning connectivity
# This runs before the install archive supplies the full status commands.
mkdir -p /var/lib /usr/local/bin /etc/update-motd.d
if [ ! -x /usr/local/bin/manet-provision-status.sh ]; then
    cat > /usr/local/bin/manet-provision-status.sh <<'BOOT_STATUS'
#!/bin/bash
# Report early bootstrap status before the full tools are installed.
STATE= PHASE= LOG=
while IFS='=' read -r key value; do
    case "$key" in
        STATE) STATE="$value" ;; PHASE) PHASE="$value" ;; LOG) LOG="$value" ;;
    esac
done < /var/lib/manet-provision.state
printf '\n  MANET provisioning: %s\n  Stage: %s\n' "$STATE" "$PHASE"
if [ "$STATE" = incomplete ]; then
    cat /var/lib/manet-provision.failures
    echo '  Restore Ethernet internet access, then reboot to retry.'
    echo '  Or run: sudo systemctl restart mesh-provision.service'
fi
printf '  Log: %s\n\n' "$LOG"
exit 0
BOOT_STATUS
    chmod 755 /usr/local/bin/manet-provision-status.sh
fi
ln -sf /usr/local/bin/manet-provision-status.sh \
    /etc/update-motd.d/50-manet-provision

# Use the same LED names and failure pattern as manet-led-status.sh.
bootstrap_led() {
    local mode="$1" names="$2" led max
    for led in $names; do
        led="/sys/class/leds/$led"
        [ -w "$led/trigger" ] || continue
        case "$mode" in
            wait)
                echo timer > "$led/trigger"
                echo 100 > "$led/delay_on"
                echo 100 > "$led/delay_off" ;;
            heartbeat) echo heartbeat > "$led/trigger" ;;
            on)
                echo none > "$led/trigger"
                max=$(cat "$led/max_brightness" 2>/dev/null)
                case "$max" in ''|*[!0-9]*) max=1 ;; esac
                printf '%s\n' "$max" > "$led/brightness" ;;
        esac
        return 0
    done
    return 0
}

# Record the same verdict schema consumed by the banner and LED service.
bootstrap_state() {
    local state="$1" now temporary
    now=$(date +%s)
    temporary=$(mktemp /var/lib/.manet-provision.XXXXXX) || return 1
    printf '%s\n' "STATE=$state" "PHASE=bootstrap-network" \
        "STARTED=$BOOTSTRAP_STARTED" "UPDATED=$now" \
        "LOG=$BOOTSTRAP_LOG" > "$temporary"
    [ "$state" != incomplete ] || echo "FINISHED=$now" >> "$temporary"
    chmod 644 "$temporary" &&
        mv -f "$temporary" /var/lib/manet-provision.state &&
        sync -f /var/lib/manet-provision.state
}

# HEAD follows the download path without accepting executable data.
# No certificate-date dependency before the best-effort HTTP clock step.
bootstrap_probe() {
    local url="$1" uptime remaining code
    read -r uptime _ < /proc/uptime
    remaining=$((BOOTSTRAP_DEADLINE - ${uptime%.*}))
    [ "$remaining" -gt 0 ] || return 1
    [ "$remaining" -le 10 ] || remaining=10
    code=$(curl --fail --silent --show-error --head --location --insecure \
        --proto '=http,https' --proto-redir '=http,https' \
        --connect-timeout 3 --max-time "$remaining" \
        --output /dev/null --write-out '%{http_code}' "$url") || return 1
    [ "$code" = 200 ]
}

# Require installation resources, with a five-minute monotonic total budget.
# HTTP Date remains optional, as in the logging-clock step below.
bootstrap_wait() {
    local uptime remaining missing base asset
    read -r uptime _ < /proc/uptime
    BOOTSTRAP_DEADLINE=$((${uptime%.*} + 300))
    bootstrap_probe http://google.com ||
        echo 'HTTP Date endpoint unavailable; continuing resource checks'
    while true; do
        missing=
        bootstrap_probe http://deb.debian.org/debian/dists/trixie/InRelease ||
            missing='Debian archive'
        bootstrap_probe '__INSTALL_URL__' ||
            missing="${missing:+$missing, }MANET GitHub release"
        if [ "__INSTALL_MEDIAMTX__" = y ]; then
            base=https://github.com/bluenviron/mediamtx/releases/download
            asset="mediamtx_${MEDIAMTX_VERSION}_linux_arm64.tar.gz"
            bootstrap_probe "$base/$MEDIAMTX_VERSION/$asset" ||
                missing="${missing:+$missing, }MediaMTX GitHub release"
        fi
        [ -n "$missing" ] || return 0
        read -r uptime _ < /proc/uptime
        remaining=$((BOOTSTRAP_DEADLINE - ${uptime%.*}))
        if [ "$remaining" -le 0 ]; then
            printf '%s\n' "Timed out after 300s waiting for: $missing" \
                > /var/lib/manet-provision.failures
            bootstrap_state incomplete || return 1
            bootstrap_led heartbeat 'PWR led1 red:power power'
            bootstrap_led on 'ACT led0 green:status status'
            /usr/local/bin/manet-provision-status.sh
            return 1
        fi
        echo "Waiting for installation resources: $missing (${remaining}s left)"
        [ "$remaining" -le 5 ] || remaining=5
        sleep "$remaining"
    done
}

MEDIAMTX_VERSION='v1.15.3'
BOOTSTRAP_STARTED=$(date +%s)
: > /var/lib/manet-provision.failures
bootstrap_state running || exit 1
bootstrap_led wait 'PWR led1 red:power power'
bootstrap_wait || exit 1
bootstrap_led on 'PWR led1 red:power power'
echo 'Installation resources reachable'
# END bounded provisioning connectivity

# Best-effort HTTP Date for readable logs; downloads do not trust this clock.
http_date=$(curl --fail --silent --show-error --head --proto '=http' \
    --connect-timeout 5 --max-time 10 http://google.com | \
    grep -i '^Date:' | cut -d' ' -f2-)
if [ -n "$http_date" ]; then
    date -s "$http_date" || echo "Could not set the logging clock; continuing"
else
    echo "No HTTP Date available; continuing without setting the logging clock"
fi

cd /root

# Get rid of the extra nonsense printed on an SSH connection
> /etc/motd

# The flasher pins setup and packages to the same published release.
MANET_INSTALL_URL='__INSTALL_URL__'
MANET_INSTALL_SHA256='__INSTALL_SHA256__'
MANET_INSTALL_VERSION='__RELEASE_VERSION__'
case "$MANET_INSTALL_URL" in
    https://github.com/very-srs/MANET/releases/download/v[0-9]*/*-install.tar.gz) ;;
    *) echo "ERROR: Missing or invalid MANET release selection"; exit 1 ;;
esac
echo "Downloading MANET $MANET_INSTALL_VERSION install package..."
curl --fail --silent --show-error --location --insecure --proto '=https' --proto-redir '=https' \
    --connect-timeout 15 --max-time 600 --retry 3 \
    "$MANET_INSTALL_URL" -o /root/morse-pi-install.tar.gz || exit 1
printf '%s  %s\n' "$MANET_INSTALL_SHA256" /root/morse-pi-install.tar.gz | sha256sum -c - || exit 1
for marker in ./etc/manet_version.txt ./usr/local/bin/version.txt; do
    installed_version=$(tar -xzOf /root/morse-pi-install.tar.gz "$marker") || exit 1
    [ "${installed_version%%$'\n'*}" = "$MANET_INSTALL_VERSION" ] || {
        echo "ERROR: Install package version does not match the selected release"
        exit 1
    }
done

#
#  Setup base system
#

# Install kernel protection from the verified archive.
# Extract only these files before any APT transaction touches the base image.
tar -zxf /root/morse-pi-install.tar.gz --no-overwrite-dir -C / \
    ./etc/apt/preferences.d/00-manet-kernel \
    ./usr/local/bin/manet-kernel-protect.py || exit 1
python3 /usr/local/bin/manet-kernel-protect.py \
    --board __HARDWARE_MODEL__ || exit 1
# End kernel protection.

# get the sources up to date and install packages
echo -n "Updating system packages..."
apt update > /dev/null 2>&1
apt upgrade -y > /dev/null 2>&1

# Remove the question about the iperf daemon during apt install
echo "iperf3 iperf3/start_daemon boolean true" | debconf-set-selections

# Install packages for this system
apt install -y --no-install-recommends ipcalc-ng nmap lshw tcpdump net-tools nftables wireless-tools iperf3\
		radvd bridge-utils firmware-mediatek libnss-mdns syncthing networkd-dispatcher\
		libgps-dev libcap-dev screen arping bc jq git libssl-dev hostapd dnsmasq\
		python3-protobuf unzip chrony build-essential systemd-resolved dhcping mpg123\
		libnl-3-dev libnl-genl-3-dev libnl-route-3-dev ebtables libdbus-1-dev gpsd\
		alsa-utils alsa-ucm-conf alsa-topology-conf rfkill iw wireless-regdb\
		libnss-resolve libnss-myhostname netcat-openbsd\
		gstreamer1.0-alsa gstreamer1.0-plugins-base gstreamer1.0-plugins-good python3-gi gir1.2-gstreamer-1.0

# Unpack the tar file: contains kernel, modules, firmware, and mesh tools
tar -zxf /root/morse-pi-install.tar.gz -C /

# Link this to where scripts expect it, updated from the old perl version
ln -s /usr/bin/ipcalc-ng /usr/bin/ipcalc

# Disable predictable interface names for Armbian
sed -i '/^extraargs=/ s/$/ net.ifnames=0/' /boot/armbianEnv.txt

# Installed but not being used now
systemctl stop dnsmasq
systemctl disable dnsmasq
systemctl mask dnsmasq
# If dnsmasq started first and held 127.0.0.53, resolved came up without
# its stub listener (and possibly without its D-Bus name, when its user was
# created during the same apt run). Restart it so the downloads below resolve.
systemctl restart systemd-resolved
echo "Done"

# probably not installed, but the debian package is old
apt remove -y avahi yq > /dev/null 2>&1

# Download and verify Go yq before installing it.
# Keep these pins identical in both templates; provisioning tests enforce this.
YQ_VERSION='v4.54.1'
YQ_SHA256='189088da0c6429ec5178dfaab1a114805f6cab0b61b165ab236efedf1d57a71b'
YQ_DOWNLOAD=$(mktemp) || exit 1
curl --fail --silent --show-error --location --insecure --proto '=https' --proto-redir '=https' \
    --connect-timeout 15 --max-time 600 --retry 3 \
    "https://github.com/mikefarah/yq/releases/download/$YQ_VERSION/yq_linux_arm64" \
    -o "$YQ_DOWNLOAD" || exit 1
printf '%s  %s\n' "$YQ_SHA256" "$YQ_DOWNLOAD" | sha256sum -c - || exit 1
install -m 0755 "$YQ_DOWNLOAD" /usr/bin/yq || exit 1
rm -f "$YQ_DOWNLOAD"
# End pinned yq install.

# These add network traffic, disable them
echo "Disabling APT timers for automatic updates"
systemctl disable apt-daily.timer > /dev/null 2>&1
systemctl disable apt-daily-upgrade.timer > /dev/null 2>&1

# This was hanging on boot, disable it
systemctl mask dev-zram0.device > /dev/null 2>&1

# Load batman-adv module at boot
echo "batman_adv" > /etc/modules-load.d/batman.conf

# Load modules at boot
cat << EOF > /etc/modules-load.d/morse.conf
mac80211
cfg80211
crc7
morse
dot11ah
EOF

# Load the morse driver with options to allow the interface to be picked up
# This will be re-written by radio-setup to select the correct region
cat << EOF > /etc/modprobe.d/morse.conf
options morse country=US
options morse enable_mcast_whitelist=0 enable_mcast_rate_control=1
EOF

# More kernel tweaks
cat << EOF > /etc/sysctl.d/99-mesh.conf
# IPv4 forwarding
net.ipv4.conf.all.forwarding=1
net.ipv4.conf.default.forwarding=1

# IPv6 forwarding
net.ipv6.conf.all.forwarding=1
net.ipv6.conf.default.forwarding=1

# IPv6 multicast forwarding
net.ipv6.conf.all.mc_forwarding=1
net.ipv6.conf.default.mc_forwarding=1
net.ipv6.conf.bat0.mc_forwarding=1
net.ipv6.conf.br0.mc_forwarding=1

# Increase multicast route cache for large mesh
net.ipv4.route.max_size=16384
net.ipv6.route.max_size=16384

# Optional: Increase ARP cache for many nodes
net.ipv4.neigh.default.gc_thresh1=1024
net.ipv4.neigh.default.gc_thresh2=2048
net.ipv4.neigh.default.gc_thresh3=4096
EOF

#
#  Create the non wifi interfaces
#

# Create the batman-adv interface, enslave it to br0
# Tell it to get the correct LL address for alfred to work
cat << EOF > /etc/systemd/network/10-bat0.network
[Match]
Name=bat0

[Network]
Bridge=br0
LinkLocalAddressing=ipv6
IPv6Token=eui64
IPv6PrivacyExtensions=no

# br0 snoops IGMP, so unjoined groups such as ATAK SA (239.2.3.1) only reach
# router ports. bat0 must always be one, or a node that hears no IGMP query
# on the mesh keeps its EUDs' multicast to itself.
[Bridge]
MulticastRouter=permanent

[Link]
MTUBytes=1500
EOF

# The bridge br0 is the main interface for the mesh node
cat << EOF > /etc/systemd/network/10-br0-bridge.netdev
[NetDev]
Name=br0
Kind=bridge

[Bridge]
MulticastSnooping=true
MulticastQuerier=true
EOF

# br0 will get a slaac ipv6 address
# Scripts will give it an ipv4 address later on
cat << EOF > /etc/systemd/network/20-br0-bridge.network
[Match]
Name=br0

[Network]
DHCP=no
LinkLocalAddressing=ipv6
IPv6AcceptRA=yes
MulticastDNS=yes

[Link]
RequiredForOnline=no
MTUBytes=1500
EOF

#stop other interfaces from doing multicast dns, trim down network chatter
cat << EOF > /etc/systemd/network/90-default-no-mdns.network
[Match]
Name=!br0

[Network]
LLMNR=no
MulticastDNS=no
EOF

# Set ethernet links for DHCP as a default setup.  Scripts will juggle this
# around later for device detection
CT=0
for LAN in `networkctl | grep -v bat | awk '/ether/ {print $2}'`; do
    M=$(ip link show $LAN | awk '/ether/ {print $2}')
    cat <<- EOF > /etc/systemd/network/10-end${CT}.network
		[Match]
		MACAddress=$M

		[Network]
		DHCP=yes
		LinkLocalAddressing=no
		IPv6AcceptRA=no

		# BEGIN MANET qualified DNS
		[DHCPv4]
		UseDNS=no
		UseDomains=no
		RoutesToDNS=no
		RequestOptions=6 15 119

		[DHCPv6]
		UseDNS=no
		UseDomains=no

		[IPv6AcceptRA]
		UseDNS=no
		UseDomains=no
		# END MANET qualified DNS
	EOF
    cat <<- EOF > /etc/systemd/network/11-end${CT}-rename.link
		[Match]
		OriginalName=eth0

		[Link]
		MACAddress=$M
		Name=end${CT}
	EOF
    cp /etc/systemd/network/10-end${CT}.network \
        /etc/systemd/network/10-end${CT}.network.dhcp-default
    (( CT++ ))
    break
done
echo "Ethernet config added"

# Create ethernet templates for ethernet-autodetect.sh (OUTSIDE the loop)
echo "Creating ethernet detection templates..."
cat << 'EOF' > /etc/systemd/network/20-end0-gateway.network.off
[Match]
Name=end0

[Network]
DHCP=yes
LinkLocalAddressing=no
IPv6AcceptRA=no

# BEGIN MANET qualified DNS
[DHCPv4]
UseDNS=no
UseDomains=no
RoutesToDNS=no
RequestOptions=6 15 119

[DHCPv6]
UseDNS=no
UseDomains=no

[IPv6AcceptRA]
UseDNS=no
UseDomains=no
# END MANET qualified DNS
EOF

cat << 'EOF' > /etc/systemd/network/20-end0-eud.network.off
[Match]
Name=end0

[Network]
Bridge=br0
LinkLocalAddressing=no
IPv6AcceptRA=no

[Link]
RequiredForOnline=no
EOF
echo "Ethernet templates created"

#
# Configure and enable system services
#

#  Set up the node firewall to accept just about everything and to forward traffic out the
#  ethernet interface.
#  This can just be set and forgotten and will only make a difference
#  when the node is plugged into a network

#  Should consider moving this to radio setup to take advantage of better interface detection
echo "Configuring nftables for IPv4 NAT gateway"
cat << EOF > /etc/nftables.conf
#!/usr/sbin/nft -f

# Flush the old ruleset to start clean
flush ruleset
table inet filter {
  # The INPUT chain handles traffic destined for the node itself.
  chain input {
	type filter hook input priority 0; policy drop;
	ct state {established, related} accept
	ct state invalid drop
	iifname "lo" accept
	# Accept ALL traffic coming from the trusted mesh interface.
	iifname "br0" accept
	iifname "bat0" accept
	iifname "end0" accept
  }
  chain forward {
	type filter hook forward priority 0; policy drop;

    # Allow forwarding within the mesh bridge (EUD → gateway)
    iifname "br0" oifname "br0" accept

	# Allow traffic from the trusted mesh to be forwarded
	# out to the internet via the Ethernet port.
	iifname "br0" oifname "end0" accept

	# Allow the return traffic from the internet back to the mesh.
	iifname "end0" oifname "br0" ct state established, related accept
  }
  chain output {
	type filter hook output priority 0; policy accept;
  }
}

table ip nat {
  chain postrouting {
	type nat hook postrouting priority 100;
	oifname "end0" masquerade
  }
}

table inet mesh_mangle {
    chain forward {
        type filter hook forward priority mangle; policy accept;
        tcp flags syn tcp option maxseg size set 1400
    }
}
EOF

echo "Setting up router advertisements"
# Configure router advertisements for slaac on ipv6
# The announced ipv6 prefix with be where all the nodes
# auto configure their addresses to be local to each other
#
# The two files are for when the node is a client
# ( AdvDefaultLifetime 0 ) vs when it advertises itself as
# a gateway ( AdvDefaultLifetime 600 ).  A networkd-dispatcher
# script does the swap
cat << EOF > /etc/radvd-mesh.conf
interface br0
{
  AdvSendAdvert on;
  AdvDefaultLifetime 0;
  prefix fd01:ed20:ecb4:0::/64  {
	AdvOnLink on;
	AdvAutonomous on;
	AdvRouterAddr off;
  };
};
EOF

cat << EOF > /etc/radvd-gateway.conf
interface br0 {
  AdvSendAdvert on;
  AdvDefaultLifetime 600;
  prefix fd01:ed20:ecb4:0::/64  {
	AdvOnLink on;
	AdvAutonomous on;
  };
};
EOF

# Default to mesh config
cp /etc/radvd-mesh.conf /etc/radvd.conf

# make radvd wait for bat0 to be up
mkdir -p /etc/systemd/system/radvd.service.d/
cat << EOF > /etc/systemd/system/radvd.service.d/override.conf
[Unit]
After=batman-enslave.service
Wants=batman-enslave.service

[Service]
ExecStartPre=/bin/sleep 5
EOF

systemctl enable radvd

# Time service: continuous local GPS/uplink discipline, occasional peer refresh.
# Keep this generated unit identical to MANET/systemd/one-shot-time-sync.service.
cat <<'EOF' > /etc/systemd/system/one-shot-time-sync.service
[Unit]
Description=MANET GPS, uplink and periodic peer time synchronization
After=node-manager.service gps-reader.service
Wants=node-manager.service gps-reader.service
PartOf=node-manager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/one-shot-time-sync.sh
Restart=always
RestartSec=10
TimeoutStopSec=20
ExecStopPost=/usr/bin/rm -f /run/mesh-ntp.state /run/mesh-ntp-gps.state

[Install]
WantedBy=multi-user.target
EOF
# radio-setup enables it; the node-manager drop-in also starts it.

# Quiet bootstrap config; mesh-time-sync.py manages the active role after boot.
cat <<'EOF' > /etc/chrony/chrony.conf
driftfile /var/lib/chrony/chrony.drift
makestep 0.1 3
deny all
EOF
systemctl enable chrony.service

# Set br0 to be the wait online interface, avoids boot delay
mkdir -p /etc/systemd/system/systemd-networkd-wait-online.service.d/
cat <<- EOF > /etc/systemd/system/systemd-networkd-wait-online.service.d/override.conf
[Service]
ExecStart=
ExecStart=/lib/systemd/systemd-networkd-wait-online --interface=br0
EOF
# But let's not us it
systemctl mask systemd-networkd-wait-online.service

# Disable netplan, networkd will do the networking
mkdir -p /etc/netplan
rm -f /etc/netplan/*
cat << EOF > /etc/netplan/99-disable-netplan.yaml
# This file tells Netplan to do nothing.
network:
version: 2
renderer: networkd
EOF
echo "Netplan disabled, will use networkd instead"

# Configure resolved
cat << EOF > /etc/systemd/resolved.conf
[Resolve]
LLMNR=no
MulticastDNS=no
DNSStubListener=yes
Cache=yes
EOF

# Old issue, but useful to avoid any hung mesh node so leaving this in
cat << EOF > /etc/sysctl.d/90-kernelpanic-reboot.conf
kernel.panic = 10
kernel.panic_on_oops = 1
EOF

# Restore DNS after installing dnsmasq. Keep the image's working resolver for
# remaining package downloads until networkd takes over the uplink below.
systemctl restart systemd-resolved

echo "Disabling default chrony networkd-dispatcher script"
rm -Rf /usr/lib/NetworkManager/dispatcher.d/*

# Install optional service selections
if [ "__INSTALL_MUMBLE__" = "y" ]; then
		DEBIAN_FRONTEND=noninteractive apt-get install -y \
			-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold sqlite3 mumble-server
		#make mumble server ini changes
		sed -i '/ice="tcp -h 127.0.0.1 -p 6502"/s/^#//g' /etc/mumble/mumble-server.ini
		sed -i 's/icesecretwrite/;icesecretwrite/g' /etc/mumble/mumble-server.ini
		service mumble-server restart
		grep -m 1 SuperUser /var/log/mumble-server/mumble-server.log > /root/mumble_pw
fi

# install mediaMTX server
if [ "__INSTALL_MEDIAMTX__" = "y" ]; then
	echo "Installing MediaMTX"
    # Download and verify MediaMTX before extracting it.
    # Keep these pins identical in both templates; provisioning tests enforce this.
    MEDIAMTX_SHA256='5f3cb84ef42952a82b1ff5764fd06dc13697d21b06eb179d83663ec55d15ed0c'
    MEDIAMTX_DIR=$(mktemp -d) || exit 1
    cd "$MEDIAMTX_DIR" || exit 1
    curl --fail --silent --show-error --location --insecure --proto '=https' --proto-redir '=https' \
        --connect-timeout 15 --max-time 600 --retry 3 \
        "https://github.com/bluenviron/mediamtx/releases/download/$MEDIAMTX_VERSION/mediamtx_${MEDIAMTX_VERSION}_linux_arm64.tar.gz" \
        -o mediamtx.tar.gz || exit 1
    printf '%s  %s\n' "$MEDIAMTX_SHA256" mediamtx.tar.gz | sha256sum -c - || exit 1
    tar -xzf mediamtx.tar.gz || {
        echo "ERROR: Failed to extract MediaMTX"
        exit 1
    }
    # End pinned MediaMTX extraction.

		groupadd --system mediamtx
		useradd --system -g mediamtx -d /opt/mediamtx -s /sbin/nologin mediamtx
		mkdir /etc/mediamtx && chown mediamtx:mediamtx /etc/mediamtx
		mkdir -p /opt/mediamtx
		cp mediamtx /opt/mediamtx/
		chmod +x /opt/mediamtx/mediamtx
		cp mediamtx.yml /etc/mediamtx/
        cd /root || exit 1
        rm -rf "$MEDIAMTX_DIR"

cat << EOF > /etc/systemd/system/mediamtx.service
[Unit]
Description=MediaMTX RTSP/RTMP/WebRTC Server
After=network.target

[Service]
User=mediamtx
Group=mediamtx
WorkingDirectory=/opt/mediamtx
ExecStart=/opt/mediamtx/mediamtx /etc/mediamtx/mediamtx.yml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
fi

chmod +x /usr/local/bin/*

echo "Setting radio-setup.sh to run at next reboot"
#set up the second provisioning script to run at boot
cat << EOF > /etc/systemd/system/radio-setup-run-once.service
[Unit]
Description=Run radio setup script once after reboot
After=network-online.target multi-user.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/radio-setup.sh
ExecStartPre=/bin/sleep 10
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
EOF
systemctl enable radio-setup-run-once.service

echo "Disabling network manager"
systemctl stop dhcpcd
systemctl disable dhcpcd
systemctl stop NetworkManager
systemctl disable NetworkManager
systemctl mask NetworkManager

echo "Enabling systemd-networkd and systemd-resolved"
systemctl enable --now systemd-networkd
# Publish DHCP DNS only after the direct link qualifies for internet access.
/usr/local/bin/manet-dns-setup.sh || exit 1
/usr/local/bin/manet-uplink-dns.py install || exit 1
systemctl enable --now manet-uplink-dns.path manet-uplink-dns.service || exit 1
systemctl enable manet-wifi-uplink.service || exit 1

#write out the config selections for future use
{ set +x; } 2>/dev/null   # secrets follow: keep them out of the trace log
echo "mesh_key=__MESH_SAE_KEY__" > /etc/mesh.conf
echo "ssh_user=__RADIO_USER__" >> /etc/mesh.conf
echo "mesh_ssid=__MESH_SSID__" >> /etc/mesh.conf
echo "regulatory_domain=__REGULATORY_DOMAIN__" >> /etc/mesh.conf
echo "halow_regulatory_domain=__HALOW_REGULATORY_DOMAIN__" >> /etc/mesh.conf
echo "lan_ap_ssid=__LAN_AP_SSID__" >> /etc/mesh.conf
echo "lan_ap_key=__LAN_AP_KEY__" >> /etc/mesh.conf
echo "ipv4_network=__LAN_CIDR_BLOCK__"  >> /etc/mesh.conf
echo "mumble=__INSTALL_MUMBLE__" >> /etc/mesh.conf
# ATAK is core: absent also means on; set atak=n explicitly to opt out.
echo "atak=y" >> /etc/mesh.conf
systemctl enable manet-atak.service
echo "mtx=__INSTALL_MEDIAMTX__" >> /etc/mesh.conf
# This block rewrites the mesh.conf the flasher already wrote, so the voice
# keys have to be repeated here or they are lost: same trap as admin_password
# below.
echo "voice=__VOICE_ENABLED__" >> /etc/mesh.conf
# Talk group 1 for every node. This is a per-radio setting changed from the
# web UI (and later the enclosure rotary switch), not a build-time one.
# Baking it into the image would mean reflashing to change channel.
echo "voice_channel=1" >> /etc/mesh.conf
# Codec, written explicitly rather than left to the daemon's default. This is
# a mesh-wide setting -- the two codecs cannot hear each other -- so every node
# has to leave the factory agreeing on it, and "whatever mesh-voice.py happens
# to default to this release" is not agreement. Change it fleet-wide from the
# VOICE tab, which stages it over Alfred like a channel or key change.
echo "voice_codec=lyra" >> /etc/mesh.conf
echo "acs=__AUTO_CHANNEL__" >> /etc/mesh.conf
echo "eud=__EUD_CONNECTION__" >> /etc/mesh.conf
echo "max_euds_per_node=__MAX_EUDS_PER_NODE__" >> /etc/mesh.conf
# This block rewrites the mesh.conf the flasher already wrote, so the admin
# password has to be repeated here or it is lost. It gates the web management
# UI (mesh-status.py /manage).
echo "admin_password=__ADMIN_PW__" >> /etc/mesh.conf
echo "auto_update=__AUTO_UPDATE__" >> /etc/mesh.conf
set -x

# node-manager.sh is a symlink to the orchestrator acs= selects; the service
# re-runs this selector before every start, so later acs changes follow.
/usr/local/bin/node-manager-select.sh

# Restore normal APT date checks before completing this phase.
cleanup_apt_clock_override || exit 1
trap - EXIT HUP INT TERM

# Disable the current script so it won't run again at next boot
systemctl disable mesh-provision

# >>> MANET_ADDITIONAL_SCRIPTS <<<

echo "=== Provisioning complete at $(date) ==="
echo "=== Rebooting to apply changes ==="
reboot
