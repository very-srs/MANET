diff --git a/src/drivers/driver_nl80211_event.c b/src/drivers/driver_nl80211_event.c
index 0b111bf..8f08027 100644
--- a/src/drivers/driver_nl80211_event.c
+++ b/src/drivers/driver_nl80211_event.c
@@ -2768,6 +2768,24 @@ static void nl80211_radar_event(struct i802_bss *bss, struct nlattr **tb)
 	data.dfs_event.freq = nla_get_u32(tb[NL80211_ATTR_WIPHY_FREQ]);
 	event_type = nla_get_u32(tb[NL80211_ATTR_RADAR_EVENT]);
 
+#ifdef CONFIG_MESH
+	/* MANET owns background CAC on the live mesh interface. These are
+	 * not foreground CAC events: feeding them to ifmsh changes ENABLED
+	 * to DFS and tries to initialize the already-running BSS on FINISHED.
+	 * Keep radar detection (including a main report during RDD2 transfer)
+	 * and all unflagged foreground events on their ordinary path.
+	 */
+	if (drv->nlmode == NL80211_IFTYPE_MESH_POINT &&
+	    tb[NL80211_ATTR_RADAR_BACKGROUND] &&
+	    (event_type == NL80211_RADAR_CAC_STARTED ||
+	     event_type == NL80211_RADAR_CAC_FINISHED ||
+	     event_type == NL80211_RADAR_CAC_ABORTED)) {
+		wpa_printf(MSG_DEBUG, "nl80211: MANET external background CAC event %d on %d MHz",
+			   event_type, data.dfs_event.freq);
+		return;
+	}
+#endif /* CONFIG_MESH */
+
 	/* Check HT params */
 	if (tb[NL80211_ATTR_WIPHY_CHANNEL_TYPE]) {
 		data.dfs_event.ht_enabled = 1;
