 				resp = WLAN_STATUS_CHALLENGE_FAIL;
 				goto reply;
 			}
@@ -1626,6 +1679,8 @@
 	}
 
 remove_sta:
+	if (!sta_removed && resp != WLAN_STATUS_SUCCESS)
+		mesh_sae_log(hapd, sta, "rx-result", status_code, resp);
 	if (auth_transaction == 1)
 		success_status = sae_status_success(hapd, status_code);
