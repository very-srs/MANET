# Morse 1.16.4 OpenWrt recipe features with mesh networking enabled.
# Debian uses nl80211 directly, without OpenWrt ubus or D-Bus.
CONFIG_DRIVER_WEXT=y
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_NL80211_QCA=y
CONFIG_LIBNL32=y
CONFIG_DRIVER_WIRED=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_WPS=y
CONFIG_WPS_ER=y
CONFIG_WPS_REG_DISABLE_OPEN=y
CONFIG_WPS_NFC=y
CONFIG_PKCS12=y
CONFIG_IPV6=y
CONFIG_CTRL_IFACE=y
CONFIG_SAE=y
CONFIG_SAE_PK=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_IEEE80211R=y
CONFIG_DEBUG_FILE=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AH=y
CONFIG_WNM=y
CONFIG_INTERWORKING=y
CONFIG_HS20=y
CONFIG_MATCH_IFACE=y
CONFIG_AP=y
CONFIG_P2P=y
CONFIG_TDLS=y
CONFIG_IBSS_RSN=y
CONFIG_PMKSA_CACHE_EXTERNAL=y
CONFIG_MESH=y
CONFIG_BGSCAN_LEARN=y
CONFIG_OWE=y
CONFIG_DPP=y
CONFIG_DPP2=y
CONFIG_DPP3=y
CONFIG_S1G_TWT=y
CONFIG_MORSE_STANDBY_MODE=y
CONFIG_MORSE_KEEP_ALIVE_OFFLOAD=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211W=y
CONFIG_WPA_CLI_EDIT=y
CFLAGS += -D_GNU_SOURCE -Wno-deprecated-declarations
