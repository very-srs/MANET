[Unit]
Description=Check the persistent MT7916 firmware selection
DefaultDependencies=no
# Not local-fs.target: /boot/firmware waits for a by-partuuid device that only
# coldplug creates, so ordering before the trigger would deadlock the boot.
After=systemd-remount-fs.service
RequiresMountsFor=/etc /usr/local /lib/firmware /var/lib
Before=systemd-udev-trigger.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/manet-mt7916-firmware.py --boot
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
