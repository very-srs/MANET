[Unit]
Description=Request 30 dBm on mesh radios, with no MANET power ceiling
# Mesh radios are enslaved to bat0 after their supplicants start, so by then
# each interface is up and on its channel.
After=batman-enslave.service

[Service]
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
PrivateDevices=yes
Type=oneshot
ExecStart=/usr/local/bin/manet-mesh-power.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
