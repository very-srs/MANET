[Unit]
Description=Waveshare UPS HAT (E) battery monitor
Documentation=https://www.waveshare.com/wiki/UPS_HAT_(E)
After=multi-user.target
Wants=multi-user.target

[Service]
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# UID 0 authorizes the low-battery poweroff request to systemd.
ReadWritePaths=/run
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/i2c-1 rw
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/battery-reader.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=battery-reader

[Install]
WantedBy=multi-user.target
