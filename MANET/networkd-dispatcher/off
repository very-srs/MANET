#!/bin/bash
TARGET_IFACE="end0"
GATEWAY_STATE_FILE="/var/run/manet-uplink/mesh-gateway.state"
NTP_STATE_FILE="/var/run/mesh-ntp.state"
ETHERNET_STATE_FILE="/var/run/ethernet_detection_state"

log() {
    printf '%s\n' "ETH-OFF: $1" | systemd-cat -t ethernet-off
}

# systemctl unmask always triggers a full daemon-reload, and enable on units
# with sysv shims (dnsmasq, hostapd) spawns update-rc.d which reloads again.
# Guard them so repeated carrier events don't churn PID 1.
unmask_if_masked() {
    [ "$(systemctl is-enabled "$1" 2>/dev/null)" = "masked" ] && \
        systemctl unmask "$1" 2>/dev/null
    return 0
}

enable_if_disabled() {
    systemctl is-enabled --quiet "$1" 2>/dev/null || \
        systemctl enable "$1" 2>/dev/null
    return 0
}

if [ "$IFACE" != "$TARGET_IFACE" ]; then
    exit 0
fi

# Serialize physical-Ethernet policy with detection and periodic reconciliation.
if [ "${MANET_ETH_LOCK_HELD:-0}" != 1 ]; then
    exec 200>/var/run/ethernet-autodetect.lock
    flock -w 90 200 || exit 1
fi
# A queued off event can be stale by the time the lock becomes available.
# The detector may also explicitly demote a DHCP link without Internet.
if [ "${MANET_ETH_FORCE_CLEANUP:-0}" != 1 ]; then
    [ "$(cat /sys/class/net/end0/carrier 2>/dev/null)" != "1" ] || exit 0
fi

log "Cable unplugged from $IFACE - selecting a surviving uplink before cleanup"

# The dispatcher shares this Ethernet lock. It replaces forwarding while the
# gateway marker is still present, so the mesh route manager cannot interpose
# a remote gateway between two qualified local connections.
RECONCILED=0
if [ -x /usr/local/bin/manet-uplink-dispatch.sh ]; then
    MANET_ETH_LOCK_HELD=1 MANET_UPLINK_LOST_IFACE="$IFACE" \
        /usr/local/bin/manet-uplink-dispatch.sh no-carrier "$IFACE" && RECONCILED=1
fi

# Qualification can take time. A new cable arriving during it belongs to the
# pending carrier event, and must not be flushed by this older loss event.
if [ "${MANET_ETH_FORCE_CLEANUP:-0}" != 1 ] &&
        [ "$(cat /sys/class/net/end0/carrier 2>/dev/null)" = 1 ]; then
    log "Carrier returned during handoff; leaving end0 for the carrier event"
    exit 0
fi

# Another live uplink, such as USB, keeps this node a gateway. Then only
# end0's own configuration is cleaned up; gateway state, NAT and the AP stay.
OTHER_UPLINK=""
UPSTREAM=$(cat /var/run/upstream_iface 2>/dev/null || true)
if [ -n "$UPSTREAM" ] && [ "$UPSTREAM" != "$IFACE" ] &&
        [ "$(cat "/sys/class/net/$UPSTREAM/carrier" 2>/dev/null)" = "1" ]; then
    OTHER_UPLINK="$UPSTREAM"
    log "Uplink $OTHER_UPLINK remains; keeping gateway state"
fi

# dnsmasq serves br0, not the uplink. Its resolver file follows qualified
# DNS automatically, without a DHCP restart or loss of leases.

# Flush all IPs from end0
log "Flushing IP addresses from $IFACE"
ip addr flush dev "$IFACE" 2>/dev/null
ip link set "$IFACE" nomaster 2>/dev/null || true

# Remove all networkd configs for end0
log "Removing networkd configs"
rm -f /etc/systemd/network/20-end0.network
rm -f /etc/systemd/network/20-end0-*.network

# Restore default DHCP config
log "Restoring default DHCP config"
cp /etc/systemd/network/10-end0.network.dhcp-default /etc/systemd/network/10-end0.network 2>/dev/null || true

# Reload networkd config files and reconfigure only end0.
# Do NOT restart systemd-networkd — a full restart kicks batman-adv interfaces
# out of bat0 when networkd reconfigures wlan0/wlan2.
networkctl reload 2>/dev/null || true
networkctl reconfigure "$IFACE" 2>/dev/null || true

# The shared dispatcher already reconciled gateway and EUD service policy.
# Only physical end0 cleanup remains in this hook.
if [ "$RECONCILED" = 1 ]; then
    log "Cleanup complete"
    exit 0
fi

# If we were a gateway through this port, revert that too
if [ -z "$OTHER_UPLINK" ] && [ -f "$GATEWAY_STATE_FILE" ]; then
    log "Was gateway - reverting gateway-specific settings..."

    # The time service observes gateway loss and removes internet sources.
    # Do not stop chrony here: a local GPS may still be disciplining it.

    # Revert batman-adv mode
    batctl gw_mode client 2>/dev/null

    # Revert radvd
    cp /etc/radvd-mesh.conf /etc/radvd.conf
    systemctl restart radvd 2>/dev/null

    # Remove NAT
    nft flush chain ip nat postrouting 2>/dev/null || true
fi

# Remove all state files
if [ -z "$OTHER_UPLINK" ]; then
    rm -f "$GATEWAY_STATE_FILE"
    rm -f "$NTP_STATE_FILE"
fi
rm -f "$ETHERNET_STATE_FILE"

AP_INTERFACE=""
if [ -f /var/lib/ap_interface ]; then
    AP_INTERFACE=$(cat /var/lib/ap_interface)
fi

# With no ethernet, keep wireless EUD service alive. AUTO also falls back to
# AP, except with ACS: only a gateway serves the AP, and this node no longer is.
EUD_MODE=$(grep "^eud=" /etc/mesh.conf 2>/dev/null | cut -d'=' -f2)
ACS_ON=n
grep -Eq '^acs=["'\'']?[yY]["'\'']?[[:space:]]*$' /etc/mesh.conf 2>/dev/null && ACS_ON=y
# A wired EUD on another port, such as a USB adapter bridged into br0, still
# takes priority over the AP in auto mode.
OTHER_WIRED_EUD=""
for port in /sys/class/net/*; do
    port=${port##*/}
    case "$port" in lo|br*|bat*|wlan*|"$IFACE") continue ;; esac
    if [ "$(basename "$(readlink "/sys/class/net/$port/master" 2>/dev/null)" 2>/dev/null)" = br0 ] &&
            [ "$(cat "/sys/class/net/$port/carrier" 2>/dev/null)" = "1" ]; then
        OTHER_WIRED_EUD="$port"
        break
    fi
done

# A surviving uplink keeps the node a gateway, so it serves the AP as usual
# unless another wired EUD remains.
if [ "$EUD_MODE" == "auto" ] && [ "$ACS_ON" = y ] && [ -f /var/lib/ap_interface ] &&
        { [ -z "$OTHER_UPLINK" ] || [ -n "$OTHER_WIRED_EUD" ]; }; then
    log "auto mode with ACS: no uplink or a wired EUD remains, AP radio stays in mesh"
    python3 /usr/local/bin/manet_ap_mesh.py mesh ||
        log "AP-to-mesh transition deferred; reconcile will retry"
elif { [ "$EUD_MODE" == "auto" ] || [ "$EUD_MODE" == "wireless" ]; } && [ -f /var/lib/ap_interface ]; then
    log "$EUD_MODE mode: No ethernet, ensuring AP/DHCP stays enabled"
    unmask_if_masked dnsmasq.service
    enable_if_disabled hostapd.service
    systemctl start hostapd.service 2>/dev/null || exit 1
    enable_if_disabled dnsmasq.service
    systemctl start dnsmasq.service 2>/dev/null
    systemctl start ap-txpower.service 2>/dev/null

fi

if [ -z "$OTHER_UPLINK" ]; then
    batctl gw_mode client 2>/dev/null || true
    # The uplink is gone; a new one is measured again before it is announced.
    /usr/local/bin/manet-uplink-speed.sh forget 2>/dev/null || true
    nft flush chain ip nat postrouting 2>/dev/null || true
fi
/usr/local/bin/mesh-ip-manager.sh 2>/dev/null || true
[ -n "$OTHER_UPLINK" ] || systemctl restart gateway-route-manager.service 2>/dev/null || true

log "Cleanup complete"
