*.img
*.deb
*.tar.gz
*.tar.gz.sha256
*.tar.gz.sha256.tmp

# Compressed OS images and their checksums (provisioning/)
*.img.xz
*.img.sha256

# Build output and backups kept beside the real artifacts
__pycache__/
*.prev-*
install_packages-orig/

# Built archives, release folders and flasher bundles; only the README is source
MANET/install_packages/*
!MANET/install_packages/README.md

# Third-party Windows installers are downloaded by the flasher, never committed
*.exe

# Downloaded kernel sources, firmware caches and build outputs
kernel-work/

# Local development environments and compiled build products
.venv/
lyra-aarch64-build/
MANET/packaging/gst-lyra/*.o
MANET/packaging/gst-lyra/*.so

# Working folder a standalone flasher copy makes for itself
manet-flasher/
MANET Flasher/
.release-*/

# Generated documentation previews and optional local build environment
docs/guide/_site/
docs/guide/.venv/
