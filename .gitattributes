* text=auto

# Runtime scripts and metadata should keep LF endings across platforms.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.socket text eol=lf
*.target text eol=lf
*.conf text eol=lf
*.rules text eol=lf
*.env text eol=lf
*.proto text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.template text eol=lf
*.sh.bak text eol=lf

# cmd.exe mishandles LF-only batch files, and these are checked out on Windows
# machines that never see a Linux normalization. PowerShell is happy with LF,
# so .ps1 is deliberately not listed here: forcing CRLF on it would rewrite
# windows.ps1 in the working tree on every Linux checkout for no gain.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary payloads and archives must never be normalized as text.
*.bin binary
*.ko binary
*.ko.xz binary
*.dtb binary
*.dtbo binary
*.img binary
*.gz binary
*.xz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.tar.gz binary
MANET/node_tools/morse_cli binary
MANET/node_tools/chronyc binary
MANET/binaries_arm64/alfred binary
MANET/binaries_arm64/batctl binary
MANET/binaries_arm64/openvlm binary
MANET/binaries_arm64/chronyc binary
MANET/binaries_arm64/wpa_cli_s1g binary
MANET/binaries_arm64/wpa_supplicant_s1g binary
MANET/install_packages/*.tar.gz binary
*.svg text eol=lf
